//+------------------------------------------------------------------+
void RenderPanel()
{
   if(!ShowPanel)
   {
      DeletePanel();
      return;
   }

   // Rebuild in strict order so MT4 cannot retain the panel below chart objects.
   DeletePanel();
   UpsertPanelBackground();

   int signalDirection=CurrentSignalDirection();
   string headerState=LifecycleText(g_lifecycleState);
   color signalStateColor=(signalDirection!=0)
                          ?DirectionColor(signalDirection)
                          :clrSilver;

   if(g_tradeActive)
   {
      headerState="ACTIVE "+DirectionText(g_tradeDirection);
      if(g_liveCouncilDirection==-g_tradeDirection)
         signalStateColor=clrOrange;
   }
   else if(g_consensusArmed)
      headerState="ARMED "+DirectionText(g_consensusDirection);

   UpsertPanelText(
      PREFIX+"CP_TITLE","XVISION PATHMINER V12 | GOLD H1",
      PanelTextColor,18,14,PanelFontSize+1,false
   );
   UpsertPanelText(
      PREFIX+"CP_HEADER_STATE",headerState,
      signalDirection!=0?DirectionColor(signalDirection):clrSilver,
      18,14,PanelFontSize,true
   );
   UpsertPanelDivider(PREFIX+"CP_DIV_TOP",43);

   UpsertPanelText(
      PREFIX+"CP_REGIME_LABEL","REGIME",clrSlateGray,
      16,53,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_REGIME",
      RegimeText(g_regime)+" "+
      DoubleToString(g_regimeProbability*100.0,1)+
      "% | NOV "+DoubleToString(g_noveltyRatio,2)+
      " "+StructuralBreakText(),
      g_noveltyRatio>MaximumNoveltyRatio?clrOrangeRed:clrGold,
      92,51,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_H1_LABEL","SIGNAL",clrSlateGray,
      16,79,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_H1_STATE",
      CompactSignalLine(),
      signalStateColor,
      92,77,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_CALLS_LABEL","COUNCIL",clrSlateGray,
      16,105,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_CALLS",CompactCouncilRouteText(),
      PanelTextColor,
      92,103,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_MOTION_LABEL","ENTRY",clrSlateGray,
      16,131,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_MOTION",
      CurrentEntryTruthText(),
      PanelTextColor,
      92,129,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_ROUTE_LABEL","LEVELS",clrSlateGray,
      16,157,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_ROUTE",CompactLevelsText(),
      signalDirection!=0?DirectionColor(signalDirection):clrSilver,
      92,155,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_DRIFT_LABEL","HEALTH",clrSlateGray,
      16,183,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_DRIFT",CompactHealthText(),
      SevereDriftVeto()?clrOrangeRed:
      (g_driftState=="NORMAL"?clrLightGreen:clrGold),
      92,181,PanelFontSize,false
   );

   RenderDetailedDiagnostics();
}

//+------------------------------------------------------------------+
void RenderDetailedDiagnostics()
{
   if(!ShowDetailedDiagnostics)
   {
      DeleteObject(PREFIX+"CP_DIV_DETAIL");
      DeleteObject(PREFIX+"CP_D1_LABEL");
      DeleteObject(PREFIX+"CP_D1");
      DeleteObject(PREFIX+"CP_D2_LABEL");
      DeleteObject(PREFIX+"CP_D2");
      DeleteObject(PREFIX+"CP_D3_LABEL");
      DeleteObject(PREFIX+"CP_D3");
      DeleteObject(PREFIX+"CP_SIGNAL_LABEL");
      DeleteObject(PREFIX+"CP_SIGNAL");
      return;
   }

   UpsertPanelDivider(PREFIX+"CP_DIV_DETAIL",206);
   UpsertPanelText(
      PREFIX+"CP_D1_LABEL","BANKS",clrSlateGray,
      16,217,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_D1",
      "G B "+SignedPanelValue(g_globalBuy,3)+
      " S "+SignedPanelValue(g_globalSell,3)+
      " | SP B "+SignedPanelValue(g_specialBuy,3)+
      " S "+SignedPanelValue(g_specialSell,3),
      clrSilver,92,215,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_D2_LABEL","REPUT.",clrSlateGray,
      16,241,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_D2",CompactReputationText(),
      clrLightSteelBlue,92,239,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_D3_LABEL","SHADOW",clrSlateGray,
      16,265,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_D3",CurrentShadowText(),
      clrAqua,92,263,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_SIGNAL_LABEL","ROUTE",clrSlateGray,
      16,289,PanelFontSize-1,false
   );
   UpsertPanelText(
      PREFIX+"CP_SIGNAL",g_councilExplanation,
      clrSilver,92,287,PanelFontSize-1,false
   );
}

//+------------------------------------------------------------------+
int PanelLeftPosition()
{
   long chartWidth=ChartGetInteger(
      0,CHART_WIDTH_IN_PIXELS,0
   );
   int panelLeft=(int)chartWidth-
                 PanelRightMargin-PanelWidth;

   if(panelLeft<0)
      panelLeft=0;

   return(panelLeft);
}

//+------------------------------------------------------------------+
bool CreatePanelRectangle(string name,
                          int x,
                          int y,
                          int width,
                          int height,
                          color fillColor,
                          color borderColor,
                          int borderType)
{
   ResetLastError();

   if(!ObjectCreate(
      0,name,OBJ_RECTANGLE_LABEL,0,0,0
   ))
   {
      Print(
         "XVISION V12 panel object failed: ",
         name," error ",GetLastError()
      );
      return(false);
   }

   ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,name,OBJPROP_XSIZE,width);
   ObjectSetInteger(0,name,OBJPROP_YSIZE,height);
   ObjectSetInteger(0,name,OBJPROP_BGCOLOR,fillColor);
   ObjectSetInteger(0,name,OBJPROP_BORDER_TYPE,borderType);
   ObjectSetInteger(0,name,OBJPROP_COLOR,borderColor);
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
   return(true);
}

//+------------------------------------------------------------------+
void UpsertPanelBackground()
{
   int panelLeft=PanelLeftPosition();
   int effectiveHeight=ShowDetailedDiagnostics
                       ?318
                       :MathMax(PanelHeight,214);

   CreatePanelRectangle(
      PREFIX+"PANEL_SHADOW",
      panelLeft+4,PanelTopMargin+4,
      PanelWidth,effectiveHeight,
      PANEL_SHADOW_BACKGROUND,
      PANEL_SHADOW_BACKGROUND,
      BORDER_FLAT
   );

   CreatePanelRectangle(
      PREFIX+"PANEL_BG",
      panelLeft,PanelTopMargin,
      PanelWidth,effectiveHeight,
      PANEL_OPAQUE_BACKGROUND,
      PanelBorder,
      BORDER_RAISED
   );
}

//+------------------------------------------------------------------+
void UpsertPanelText(string name,
                     string text,
                     color textColor,
                     int xOffset,
                     int yOffset,
                     int fontSize,
                     bool alignRight)
{
   if(!ObjectCreate(
      0,name,OBJ_LABEL,0,0,0
   ))
      return;

   int panelLeft=PanelLeftPosition();

   ObjectSetInteger(
      0,name,OBJPROP_CORNER,
      CORNER_LEFT_UPPER
   );

   ObjectSetInteger(
      0,name,OBJPROP_ANCHOR,
      alignRight?ANCHOR_RIGHT_UPPER:ANCHOR_LEFT_UPPER
   );

   ObjectSetInteger(
      0,name,OBJPROP_XDISTANCE,
      alignRight
      ?panelLeft+PanelWidth-xOffset
      :panelLeft+xOffset
   );

   ObjectSetInteger(
      0,name,OBJPROP_YDISTANCE,
      PanelTopMargin+yOffset
   );

   ObjectSetInteger(
      0,name,OBJPROP_COLOR,
      textColor
   );

   ObjectSetInteger(
      0,name,OBJPROP_FONTSIZE,
      fontSize
   );

   ObjectSetString(
      0,name,OBJPROP_FONT,
      "Arial"
   );

   ObjectSetString(
      0,name,OBJPROP_TEXT,
      text
   );

   ObjectSetInteger(
      0,name,OBJPROP_SELECTABLE,false
   );

   ObjectSetInteger(
      0,name,OBJPROP_HIDDEN,true
   );

   ObjectSetInteger(
      0,name,OBJPROP_BACK,false
   );

}

//+------------------------------------------------------------------+
void UpsertPanelDivider(string name,int yOffset)
{
   if(!ObjectCreate(
      0,name,OBJ_RECTANGLE_LABEL,0,0,0
   ))
      return;

   int panelLeft=PanelLeftPosition();
   ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(
      0,name,OBJPROP_XDISTANCE,panelLeft+18
   );
   ObjectSetInteger(
      0,name,OBJPROP_YDISTANCE,PanelTopMargin+yOffset
   );
   ObjectSetInteger(0,name,OBJPROP_XSIZE,PanelWidth-36);
   ObjectSetInteger(0,name,OBJPROP_YSIZE,1);
   ObjectSetInteger(0,name,OBJPROP_BGCOLOR,C'48,52,58');
   ObjectSetInteger(0,name,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,name,OBJPROP_COLOR,C'48,52,58');
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

//+------------------------------------------------------------------+
void DeletePanel()
{
   DeleteObject(PREFIX+"PANEL_SHADOW");
   DeleteObject(PREFIX+"PANEL_BG");

   for(int row=0;row<=13;row++)
      DeleteObject(PREFIX+"P"+IntegerToString(row));

   for(int index=ObjectsTotal(0,-1,-1)-1;
       index>=0;
       index--)
   {
      string objectName=ObjectName(0,index);

      if(StringFind(objectName,PREFIX+"CP_",0)==0)
         ObjectDelete(0,objectName);
   }
}

//+------------------------------------------------------------------+
void DeleteObjectsByPrefix()
{
   ObjectsDeleteAll(0,PREFIX);
}

//+------------------------------------------------------------------+
void DeleteObject(string name)
{
   if(ObjectFind(0,name)>=0)
      ObjectDelete(0,name);
}
//+------------------------------------------------------------------+
