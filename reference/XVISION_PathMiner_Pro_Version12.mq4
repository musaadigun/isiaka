   -1.2222274720854, -0.86028700916786, -1.2379970369655, -1.1357051267756, -1.219078973794, -1.2619794867274, -1.2085933491946,
   0.63525731143427, -1.151399606226, -0.7550550150309
};


//+------------------------------------------------------------------+
//| Symbol restriction                                               |
//+------------------------------------------------------------------+
bool IsGoldSymbol()
{
   string symbolName=Symbol();
   StringToUpper(symbolName);

   return(StringFind(symbolName,"GOLD",0)>=0 ||
          StringFind(symbolName,"XAU",0)>=0);
}

//+------------------------------------------------------------------+
int OnInit()
{
   if(!IsGoldSymbol())
   {
      Alert("XVISION PathMiner Pro Version12 is restricted to GOLD/XAU.");
      return(INIT_FAILED);
   }

   g_h1ModeActive=(Period()==PERIOD_H1);

   if(ATRPeriod<2 ||
      ExitHorizonBars<4 ||
      TakeProfitATR<=0.0 ||
      StopLossATR<=0.0 ||
      AssumedRoundTripCost<0.0 ||
      CooldownBars<0 ||
      AdaptiveLookbackBars<ExitHorizonBars+50 ||
      AdaptiveHalfLifeBars<=0.0 ||
      AdaptivePriorWeight<0.0 ||
      MinimumAdaptiveEffectiveN<1.0 ||
      LTFM5LookbackBars<6 ||
      LTFM15LookbackBars<6 ||
      LTFMaximumAgeMultiplier<1.0 ||
      LTFMaximumAgeMultiplier>6.0 ||
      LTFM5Weight<0.0 ||
      LTFM15Weight<0.0 ||
      LTFM5Weight+LTFM15Weight<=0.0 ||
      LTFMinimumPrimeAlignment<-1.0 ||
      LTFMinimumPrimeAlignment>1.0 ||
      LTFHardVetoAlignment<-1.0 ||
      LTFHardVetoAlignment>0.0 ||
      LTFEdgeWeight<0.0 ||
      LTFEdgeWeight>0.10 ||
      StaticVoteMinimumEdge<0.0 ||
      StaticVoteMinimumSeparation<0.0 ||
      AdaptiveVoteMinimumSeparation<0.0 ||
      VoteEdgeConfidenceScale<=0.0 ||
      VoteSeparationConfidenceScale<=0.0 ||
      MinimumWeightedConsensusShare<0.50 ||
      MinimumWeightedConsensusShare>1.0 ||
      MinimumConsensusEngines<2 ||
      MinimumConsensusEngines>3 ||
      LTFVoteMinimumScore<0.0 ||
      LTFVoteMinimumScore>1.0 ||
      LTFConsensusWeight<0.0 ||
      LTFImpulseMinimumScore<0.0 ||
      LTFImpulseMinimumScore>1.0 ||
      LTFImpulseMaximumNoveltyRatio<=1.0 ||
      EngineEntryBaseOffsetATR<=0.0 ||
      EngineEntryMinimumOffsetATR<0.0 ||
      EngineEntryMinimumOffsetATR>EngineEntryBaseOffsetATR ||
      EngineEntryConfidenceDiscount<0.0 ||
      EngineEntryConfidenceDiscount>1.0 ||
      EngineEntryMotionAdjustment<0.0 ||
      EngineEntryMotionAdjustment>1.0 ||
      CandidateExpiryMinutes<5 ||
      MinimumSignalSpacingMinutes<0 ||
      ActiveSignalExpiryH1Bars<1 ||
      EntryValidDeviationATR<0.0 ||
      EntryExtendedDeviationATR<=EntryValidDeviationATR ||
      InvalidationMinimumAdverseATR<0.0 ||
      MinimumReputationSamples<1 ||
      ReputationPriorSamples<0.0 ||
      ReputationInfluence<0.0 ||
      MinimumReputationMultiplier<=0.0 ||
      MaximumReputationMultiplier<MinimumReputationMultiplier ||
      DriftEWMAWindow<2 ||
      DriftWatchThreshold<=0.0 ||
      DriftSuspectedThreshold<=DriftWatchThreshold ||
      DriftDegradedThreshold<=DriftSuspectedThreshold ||
      DriftSuspendThreshold<=DriftDegradedThreshold ||
      ShadowMinimumCouncilShare<0.50 ||
      ShadowMinimumCouncilShare>1.0 ||
      ShadowMaximumHoldBars<1 ||
      CoreCombinedEdge>=PrimeCombinedEdge ||
      GlobalBankWeight<0.0 ||
      SpecialistBankWeight<0.0 ||
      AdaptiveMemoryWeight<0.0 ||
      GlobalBankWeight+SpecialistBankWeight+AdaptiveMemoryWeight<=0.0 ||
      MinimumRegimeProbability<0.0 ||
      MinimumRegimeProbability>1.0 ||
      RegimeDistanceP95<=0.0 ||
      MaximumNoveltyRatio<=1.0 ||
      RegimeSmoothingDays<1 ||
      RegimeSmoothingDays>10 ||
      TrailHistoryDays<0 ||
      StarWidth<1 ||
      StarWidth>5 ||
      CouncilArrowWidth<1 ||
      CouncilArrowWidth>5 ||
      SignalMarkerATRPadding<0.0 ||
      PanelWidth<260 ||
      PanelHeight<170 ||
      PanelFontSize<6)
   {
      Print("XVISION PathMiner Pro V12: invalid inputs.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   SetIndexBuffer(0,PrimeBuyBuffer);
   SetIndexBuffer(1,PrimeSellBuffer);
   SetIndexBuffer(2,ImpulseBuyBuffer);
   SetIndexBuffer(3,ImpulseSellBuffer);
   ArraySetAsSeries(PrimeBuyBuffer,true);
   ArraySetAsSeries(PrimeSellBuffer,true);
   ArraySetAsSeries(ImpulseBuyBuffer,true);
   ArraySetAsSeries(ImpulseSellBuffer,true);

   SetIndexStyle(0,DRAW_ARROW,STYLE_SOLID,CouncilArrowWidth,
                 ConsensusBuyArrowColor);
   SetIndexStyle(1,DRAW_ARROW,STYLE_SOLID,CouncilArrowWidth,
                 ConsensusSellArrowColor);
   SetIndexStyle(2,DRAW_NONE);
   SetIndexStyle(3,DRAW_NONE);
   SetIndexArrow(0,CouncilBuyArrowCode);
   SetIndexArrow(1,CouncilSellArrowCode);
   SetIndexArrow(2,StarWingdingsCode);
   SetIndexArrow(3,StarWingdingsCode);
   SetIndexEmptyValue(0,EMPTY_VALUE);
   SetIndexEmptyValue(1,EMPTY_VALUE);
   SetIndexEmptyValue(2,EMPTY_VALUE);
   SetIndexEmptyValue(3,EMPTY_VALUE);
   SetIndexLabel(0,"PathMiner V12 RELEASED BUY");
   SetIndexLabel(1,"PathMiner V12 RELEASED SELL");
   SetIndexLabel(2,"");
   SetIndexLabel(3,"");

   IndicatorShortName(
      g_h1ModeActive
      ?"XVISION PathMiner Pro Version12 | Gold H1 Evidence Engine"
      :"XVISION PathMiner Pro Version12 | H1 Engine Suspended"
   );

   STATE_KEY="XV_PM12_"+Symbol()+"_H1_LAST_SIGNAL";
   g_statePrefix="XV_PM12_"+Symbol()+"_";
   g_trailFileName=BuildTrailFileName();
   g_evidenceFileName=BuildEvidenceFileName();
   g_attachBarTime=iTime(NULL,PERIOD_H1,0);
   g_lastProcessedBar=iTime(NULL,PERIOD_H1,0);
   g_lastM5Bar=iTime(NULL,PERIOD_M5,0);
   g_lastM15Bar=iTime(NULL,PERIOD_M15,0);

   ArrayInitialize(PrimeBuyBuffer,EMPTY_VALUE);
   ArrayInitialize(PrimeSellBuffer,EMPTY_VALUE);
   ArrayInitialize(ImpulseBuyBuffer,EMPTY_VALUE);
   ArrayInitialize(ImpulseSellBuffer,EMPTY_VALUE);
   ArrayInitialize(g_repN,0.0);
   ArrayInitialize(g_repWins,0.0);
   ArrayInitialize(g_repSumR,0.0);
   ArrayInitialize(g_repPositiveR,0.0);
   ArrayInitialize(g_repNegativeR,0.0);

   LoadV9PersistentState();
   EnsureEvidenceLedger();

   EventSetTimer(3);
   DeleteObjectsByPrefix();

   if(!g_h1ModeActive)
   {
      if(ShowPanel)
         RenderTimeframeNotice();

      ChartRedraw();
      return(INIT_SUCCEEDED);
   }

   LoadCallTrail();

   UpdateLiveState();
   RefreshV8EntryEngine();
   InitializeEngineCallTracker();
   UpdateDriftMonitor();

   if(LogEveryClosedH1Snapshot)
      AppendEvidenceEvent("ATTACH","INITIALIZED",0,0.0,0.0);

   if(ShowPanel)
      RenderPanel();

   ChartRedraw();
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   SaveV9PersistentState();
   EventKillTimer();
   DeleteObjectsByPrefix();
   ChartRedraw();
}

//+------------------------------------------------------------------+
void OnTimer()
{
   if(!g_h1ModeActive)
   {
      if(ShowPanel)
         RenderTimeframeNotice();

      ChartRedraw();
      return;
   }

   if(ShowPanel)
      RenderPanel();

   ChartRedraw();
}

//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if(!g_h1ModeActive)
      return(rates_total);

   if(rates_total<1000)
      return(0);

   ArraySetAsSeries(PrimeBuyBuffer,true);
   ArraySetAsSeries(PrimeSellBuffer,true);
   ArraySetAsSeries(ImpulseBuyBuffer,true);
   ArraySetAsSeries(ImpulseSellBuffer,true);

   if(prev_calculated==0)
   {
      ArrayInitialize(PrimeBuyBuffer,EMPTY_VALUE);
      ArrayInitialize(PrimeSellBuffer,EMPTY_VALUE);
      ArrayInitialize(ImpulseBuyBuffer,EMPTY_VALUE);
      ArrayInitialize(ImpulseSellBuffer,EMPTY_VALUE);
   }

   datetime currentH1Bar=iTime(NULL,PERIOD_H1,0);
   datetime currentM5Bar=iTime(NULL,PERIOD_M5,0);
   datetime currentM15Bar=iTime(NULL,PERIOD_M15,0);
   bool newH1Bar=(currentH1Bar>0 &&
                  currentH1Bar!=g_lastProcessedBar);
   bool newM5Bar=(currentM5Bar>0 && currentM5Bar!=g_lastM5Bar);
   bool newM15Bar=(currentM15Bar>0 && currentM15Bar!=g_lastM15Bar);
   bool previousTradeActive=g_tradeActive;
   int previousTradeDirection=g_tradeDirection;
   string previousTradeState=g_tradeState;
   bool previousConsensusArmed=g_consensusArmed;
   int previousConsensusDirection=g_consensusDirection;

   if(newH1Bar)
   {
      g_lastProcessedBar=currentH1Bar;
      PrimeBuyBuffer[0]=EMPTY_VALUE;
      PrimeSellBuffer[0]=EMPTY_VALUE;
      ImpulseBuyBuffer[0]=EMPTY_VALUE;
      ImpulseSellBuffer[0]=EMPTY_VALUE;
   }

   if(newM5Bar)
      g_lastM5Bar=currentM5Bar;

   if(newM15Bar)
      g_lastM15Bar=currentM15Bar;

   UpdateV8SignalState();
   UpdateShadowSignalState();

   if(newH1Bar || newM5Bar || newM15Bar)
   {
      UpdateLiveState();
      RefreshV8EntryEngine();
      UpdateDriftMonitor();

      if(newH1Bar)
      {
         EvaluateClosedBarInvalidation();
         StartShadowSignalIfEligible();

         if(LogEveryClosedH1Snapshot)
            AppendEvidenceEvent(
               "H1_SNAPSHOT",g_liveCouncilRoute,
               g_liveCouncilDirection,g_liveEntry,0.0
            );
      }

      datetime eventTime=0;

      if(newH1Bar)
         eventTime=currentH1Bar;
      if(newM5Bar && currentM5Bar>eventTime)
         eventTime=currentM5Bar;
      if(newM15Bar && currentM15Bar>eventTime)
         eventTime=currentM15Bar;
      if(eventTime<=0)
         eventTime=TimeCurrent();

      CaptureEngineCallEvents(eventTime);
   }

   MonitorV8ConsensusTrigger();
   SaveV9PersistentState();

   bool panelStateChanged=
      previousTradeActive!=g_tradeActive ||
      previousTradeDirection!=g_tradeDirection ||
      previousTradeState!=g_tradeState ||
      previousConsensusArmed!=g_consensusArmed ||
      previousConsensusDirection!=g_consensusDirection;

   if(ShowPanel &&
      (newH1Bar || newM5Bar || newM15Bar ||
       panelStateChanged))
   {
      RenderPanel();
   }

   return(rates_total);
}

//+------------------------------------------------------------------+
//| Generic forest evaluator                                         |
//+------------------------------------------------------------------+
double EvaluateAverageForest(double &features[],
                             int treeCount,
                             int &offsets[],
                             int &nodeFeatures[],
                             double &thresholds[],
                             int &leftChildren[],
                             int &rightChildren[],
                             double &values[])
{
   double total=0.0;

   for(int tree=0;tree<treeCount;tree++)
   {
      int offset=offsets[tree];
      int node=0;

      while(leftChildren[offset+node]>=0)
      {
         int featureIndex=nodeFeatures[offset+node];

         if(features[featureIndex]<=thresholds[offset+node])
            node=leftChildren[offset+node];
         else
            node=rightChildren[offset+node];
      }

      total+=values[offset+node];
   }

   return(total/(double)treeCount);
}

//+------------------------------------------------------------------+
//| H1 feature utilities                                             |
//+------------------------------------------------------------------+
double AverageVolume(int startShift,int count)
{
   double total=0.0;
   int used=0;

   for(int shift=startShift;shift<startShift+count;shift++)
   {
      long value=iVolume(NULL,PERIOD_H1,shift);

      if(value>0)
      {
         total+=(double)value;
         used++;
      }
   }

   return(used>0 ? total/used : 0.0);
}

//+------------------------------------------------------------------+
bool RollingRange(int shift,int count,double &highest,double &lowest)
{
   int highShift=iHighest(NULL,PERIOD_H1,MODE_HIGH,count,shift);
   int lowShift=iLowest(NULL,PERIOD_H1,MODE_LOW,count,shift);

   if(highShift<0 || lowShift<0)
      return(false);

   highest=iHigh(NULL,PERIOD_H1,highShift);
   lowest=iLow(NULL,PERIOD_H1,lowShift);

   return(highest>lowest && lowest>0.0);
}

//+------------------------------------------------------------------+
void ReturnStatistics(int shift,
                      int count,
                      double &entropy,
                      double &efficiency,
                      double &autocorrelation)
{
   double returns[24];
   ArrayInitialize(returns,0.0);

   int positive=0;
   double absoluteSum=0.0;

   for(int k=0;k<count;k++)
   {
      int newerShift=shift+count-1-k;
      int olderShift=newerShift+1;

      returns[k]=iClose(NULL,PERIOD_H1,newerShift)-
                 iClose(NULL,PERIOD_H1,olderShift);

      if(returns[k]>0.0)
         positive++;

      absoluteSum+=MathAbs(returns[k]);
   }

   double probability=(double)positive/(double)count;

   if(probability<=0.0 || probability>=1.0)
      entropy=0.0;
   else
      entropy=-(probability*MathLog(probability)/MathLog(2.0)+
                (1.0-probability)*MathLog(1.0-probability)/MathLog(2.0));

   efficiency=MathAbs(
      iClose(NULL,PERIOD_H1,shift)-
      iClose(NULL,PERIOD_H1,shift+count)
   )/MathMax(absoluteSum,Point);

   int pairs=count-1;
   double meanX=0.0;
   double meanY=0.0;

   for(int j=0;j<pairs;j++)
   {
      meanX+=returns[j];
      meanY+=returns[j+1];
   }

   meanX/=pairs;
   meanY/=pairs;

   double covariance=0.0;
   double varianceX=0.0;
   double varianceY=0.0;

   for(int p=0;p<pairs;p++)
   {
      double dx=returns[p]-meanX;
      double dy=returns[p+1]-meanY;

      covariance+=dx*dy;
      varianceX+=dx*dx;
      varianceY+=dy*dy;
   }

   double denominator=MathSqrt(MathMax(0.0,varianceX*varianceY));

   autocorrelation=(denominator>0.0)
                   ?covariance/denominator
                   :0.0;
}

//+------------------------------------------------------------------+
//| Build 75 completed-H1-bar features                               |
//+------------------------------------------------------------------+
bool BuildFeatures(int shift,double &features[],double &atr)
{
   ArrayResize(features,FEATURE_COUNT);
   ArrayInitialize(features,0.0);

   if(shift<1 || shift+260>=iBars(NULL,PERIOD_H1))
      return(false);

   atr=iATR(NULL,PERIOD_H1,ATRPeriod,shift);

   if(atr<=0.0 || !MathIsValidNumber(atr))
      return(false);

   double firstOpen=iOpen(NULL,PERIOD_H1,shift+5);
   int index=0;

   for(int chronological=0;chronological<6;chronological++)
   {
      int barShift=shift+5-chronological;

      double openPrice=iOpen(NULL,PERIOD_H1,barShift);
      double highPrice=iHigh(NULL,PERIOD_H1,barShift);
      double lowPrice=iLow(NULL,PERIOD_H1,barShift);
      double closePrice=iClose(NULL,PERIOD_H1,barShift);
      double range=highPrice-lowPrice;

      if(range<=0.0)
         return(false);

      double body=closePrice-openPrice;
      double upperWick=highPrice-MathMax(openPrice,closePrice);
      double lowerWick=MathMin(openPrice,closePrice)-lowPrice;

      features[index++]=body/atr;
      features[index++]=range/atr;
      features[index++]=upperWick/range;
      features[index++]=lowerWick/range;
      features[index++]=(closePrice-lowPrice)/range;
      features[index++]=(closePrice-firstOpen)/atr;
   }

   double pathHigh=-1.0e100;
   double pathLow=1.0e100;
   double bodySum=0.0;
   double absoluteBodySum=0.0;
   int upCount=0;
   int alternations=0;
   int previousSign=0;
   double previousRangeAverage=0.0;

   for(int chronological2=0;chronological2<6;chronological2++)
   {
      int barShift2=shift+5-chronological2;
      double openPrice2=iOpen(NULL,PERIOD_H1,barShift2);
      double highPrice2=iHigh(NULL,PERIOD_H1,barShift2);
      double lowPrice2=iLow(NULL,PERIOD_H1,barShift2);
      double closePrice2=iClose(NULL,PERIOD_H1,barShift2);
      double body2=closePrice2-openPrice2;
      int sign=(body2>0.0)?1:(body2<0.0?-1:0);

      pathHigh=MathMax(pathHigh,highPrice2);
      pathLow=MathMin(pathLow,lowPrice2);
      bodySum+=body2;
      absoluteBodySum+=MathAbs(body2);

      if(body2>0.0)
         upCount++;

      if(previousSign!=0 && sign!=0 && sign!=previousSign)
         alternations++;

      if(sign!=0)
         previousSign=sign;

      if(chronological2<5)
         previousRangeAverage+=highPrice2-lowPrice2;
   }

   previousRangeAverage/=5.0;

   double latestClose=iClose(NULL,PERIOD_H1,shift);
   double latestRange=iHigh(NULL,PERIOD_H1,shift)-
                      iLow(NULL,PERIOD_H1,shift);
   double pathRange=MathMax(pathHigh-pathLow,Point);

   features[index++]=(latestClose-firstOpen)/atr;
   features[index++]=pathRange/atr;
   features[index++]=MathAbs(bodySum)/MathMax(absoluteBodySum,Point);
   features[index++]=MathAbs(latestClose-firstOpen)/pathRange;
   features[index++]=(double)upCount/6.0;
   features[index++]=(double)alternations/5.0;
   features[index++]=latestRange/MathMax(previousRangeAverage,Point);

   int momentums[8]={1,2,3,6,12,24,48,72};

   for(int m=0;m<8;m++)
   {
      features[index++]=(
         latestClose-
         iClose(NULL,PERIOD_H1,shift+momentums[m])
      )/atr;
   }

   double ema10=iMA(NULL,PERIOD_H1,10,0,MODE_EMA,PRICE_CLOSE,shift);
   double ema30=iMA(NULL,PERIOD_H1,30,0,MODE_EMA,PRICE_CLOSE,shift);
   double ema75=iMA(NULL,PERIOD_H1,75,0,MODE_EMA,PRICE_CLOSE,shift);
   double ema250=iMA(NULL,PERIOD_H1,250,0,MODE_EMA,PRICE_CLOSE,shift);

   features[index++]=(ema10-ema30)/atr;
   features[index++]=(ema30-ema75)/atr;
   features[index++]=(ema75-ema250)/atr;
   features[index++]=(ema10-
      iMA(NULL,PERIOD_H1,10,0,MODE_EMA,PRICE_CLOSE,shift+3))/atr;
   features[index++]=(ema75-
      iMA(NULL,PERIOD_H1,75,0,MODE_EMA,PRICE_CLOSE,shift+10))/atr;
   features[index++]=(ema250-
      iMA(NULL,PERIOD_H1,250,0,MODE_EMA,PRICE_CLOSE,shift+20))/atr;

   features[index++]=(iRSI(NULL,PERIOD_H1,14,PRICE_CLOSE,shift)-50.0)/50.0;
   features[index++]=iADX(NULL,PERIOD_H1,14,PRICE_CLOSE,MODE_MAIN,shift)/50.0;
   features[index++]=(iADX(NULL,PERIOD_H1,14,PRICE_CLOSE,MODE_PLUSDI,shift)-
                      iADX(NULL,PERIOD_H1,14,PRICE_CLOSE,MODE_MINUSDI,shift))/50.0;

   double atr50=iATR(NULL,PERIOD_H1,50,shift);
   features[index++]=(atr50>0.0)?atr/atr50:1.0;

   double averageVolume=AverageVolume(shift,20);
   double currentVolume=(double)iVolume(NULL,PERIOD_H1,shift);
   features[index++]=(averageVolume>0.0)
                     ?currentVolume/averageVolume
                     :1.0;

   int rangePeriods[3]={24,72,120};

   for(int r=0;r<3;r++)
   {
      double highest=0.0;
      double lowest=0.0;

      if(!RollingRange(shift,rangePeriods[r],highest,lowest))
         return(false);

      features[index++]=(latestClose-lowest)/
                         MathMax(highest-lowest,Point);
      features[index++]=(highest-lowest)/atr;
   }

   double entropy=0.0;
   double efficiency=0.0;
   double autocorrelation=0.0;

   ReturnStatistics(
      shift,24,
      entropy,
      efficiency,
      autocorrelation
   );

   features[index++]=entropy;
   features[index++]=efficiency;
   features[index++]=autocorrelation;

   datetime descriptorTime=iTime(NULL,PERIOD_H1,shift);
   int hour=TimeHour(descriptorTime);
   int weekday=TimeDayOfWeek(descriptorTime)-1;

   if(weekday<0)
      weekday=4;

   features[index++]=MathSin(2.0*PI_VALUE*hour/24.0);
   features[index++]=MathCos(2.0*PI_VALUE*hour/24.0);
   features[index++]=MathSin(2.0*PI_VALUE*weekday/5.0);
   features[index++]=MathCos(2.0*PI_VALUE*weekday/5.0);

   if(index!=FEATURE_COUNT)
   {
      Print("XVISION PathMiner Pro V12 H1 feature mismatch: ",index);
      return(false);
   }

   for(int f=0;f<FEATURE_COUNT;f++)
   {
      if(!MathIsValidNumber(features[f]))
         return(false);
   }

   return(true);
}

//+------------------------------------------------------------------+
//| Daily latent-regime feature builder                              |
//+------------------------------------------------------------------+
bool BuildRegimeFeatures(int dayShift,double &features[])
{
   ArrayResize(features,REGIME_FEATURE_COUNT);
   ArrayInitialize(features,0.0);

   if(dayShift<1 ||
      dayShift+130>=iBars(NULL,PERIOD_D1))
      return(false);

   double closeNow=iClose(NULL,PERIOD_D1,dayShift);
   double atr=iATR(NULL,PERIOD_D1,14,dayShift);

   if(closeNow<=0.0 || atr<=0.0)
      return(false);

   double close20=iClose(NULL,PERIOD_D1,dayShift+20);
   double close60=iClose(NULL,PERIOD_D1,dayShift+60);
   double close120=iClose(NULL,PERIOD_D1,dayShift+120);

   if(close20<=0.0 || close60<=0.0 || close120<=0.0)
      return(false);

   features[0]=closeNow/close20-1.0;
   features[1]=closeNow/close60-1.0;
   features[2]=closeNow/close120-1.0;

   double ema20=iMA(NULL,PERIOD_D1,20,0,MODE_EMA,PRICE_CLOSE,dayShift);
   double ema60=iMA(NULL,PERIOD_D1,60,0,MODE_EMA,PRICE_CLOSE,dayShift);
   double ema120=iMA(NULL,PERIOD_D1,120,0,MODE_EMA,PRICE_CLOSE,dayShift);

   features[3]=(ema20-ema60)/atr;
   features[4]=(ema60-ema120)/atr;
   features[5]=(ema20-
      iMA(NULL,PERIOD_D1,20,0,MODE_EMA,PRICE_CLOSE,dayShift+10))/atr;
   features[6]=(ema60-
      iMA(NULL,PERIOD_D1,60,0,MODE_EMA,PRICE_CLOSE,dayShift+20))/atr;

   int highShift=iHighest(NULL,PERIOD_D1,MODE_HIGH,120,dayShift);
   int lowShift=iLowest(NULL,PERIOD_D1,MODE_LOW,120,dayShift);

   if(highShift<0 || lowShift<0)
      return(false);

   double highest=iHigh(NULL,PERIOD_D1,highShift);
   double lowest=iLow(NULL,PERIOD_D1,lowShift);
   double structuralRange=highest-lowest;

   if(structuralRange<=0.0)
      return(false);

   features[7]=(closeNow-highest)/atr;
   features[8]=(closeNow-lowest)/structuralRange;

   double positiveSquared=0.0;
   double negativeSquared=0.0;
   double absoluteMove=0.0;
   int occupancy=0;

   for(int k=0;k<20;k++)
   {
      int newerShift=dayShift+19-k;
      int olderShift=newerShift+1;

      double newerClose=iClose(NULL,PERIOD_D1,newerShift);
      double olderClose=iClose(NULL,PERIOD_D1,olderShift);

      if(newerClose<=0.0 || olderClose<=0.0)
         return(false);

      double percentReturn=newerClose/olderClose-1.0;
      double priceMove=newerClose-olderClose;

      if(percentReturn>0.0)
         positiveSquared+=percentReturn*percentReturn;
      else
         negativeSquared+=percentReturn*percentReturn;

      absoluteMove+=MathAbs(priceMove);

      double dailyEMA20=iMA(
         NULL,PERIOD_D1,20,0,
         MODE_EMA,PRICE_CLOSE,newerShift
      );

      if(newerClose>dailyEMA20)
         occupancy++;
   }

   features[9]=MathLog(
      (MathSqrt(positiveSquared)+1.0e-9)/
      (MathSqrt(negativeSquared)+1.0e-9)
   );

   features[10]=MathAbs(closeNow-close20)/
                MathMax(absoluteMove,Point);

   features[11]=(double)occupancy/20.0;
   features[12]=features[0]-features[1]/3.0;

   for(int i=0;i<REGIME_FEATURE_COUNT;i++)
   {
      if(!MathIsValidNumber(features[i]))
         return(false);
   }

   return(true);
}

//+------------------------------------------------------------------+
void RegimeProbabilities(double &features[],
                         double &probabilities[],
                         double &minimumDistance)
{
   ArrayResize(probabilities,REGIME_COUNT);
   ArrayInitialize(probabilities,0.0);

   double scores[REGIME_COUNT];
   double distances[REGIME_COUNT];
   ArrayInitialize(scores,0.0);
   ArrayInitialize(distances,0.0);
   double scoreTotal=0.0;

   minimumDistance=1.0e100;

   for(int state=0;state<REGIME_COUNT;state++)
   {
      double distanceSquared=0.0;

      for(int i=0;i<REGIME_FEATURE_COUNT;i++)
      {
         double standardized=
            (features[i]-REGIME_MEAN[i])/
            MathMax(REGIME_SCALE[i],1.0e-9);

         double difference=
            standardized-
            REGIME_CENTROID[state*REGIME_FEATURE_COUNT+i];

         distanceSquared+=difference*difference;
      }

      distances[state]=MathSqrt(MathMax(0.0,distanceSquared));
      minimumDistance=MathMin(minimumDistance,distances[state]);

      scores[state]=MathExp(
         -distanceSquared/
         (2.0*MathMax(RegimeSoftmaxTemperature,0.1))
      );

      scoreTotal+=scores[state];
   }

   if(scoreTotal<=0.0)
   {
      for(int s=0;s<REGIME_COUNT;s++)
         probabilities[s]=0.25;
      return;
   }

   for(int s2=0;s2<REGIME_COUNT;s2++)
      probabilities[s2]=scores[s2]/scoreTotal;
}

//+------------------------------------------------------------------+
bool CalculateRegimeForDescriptor(int descriptorShift,
                                  int &regime,
                                  double &probability,
                                  double &distance)
{
   datetime descriptorTime=iTime(NULL,PERIOD_H1,descriptorShift);

   if(descriptorTime<=0)
      return(false);

   int currentDayShift=iBarShift(
      NULL,PERIOD_D1,descriptorTime,false
   );

   if(currentDayShift<0)
      return(false);

   int baseDayShift=currentDayShift+1;

   double averaged[REGIME_COUNT];
   ArrayInitialize(averaged,0.0);

   distance=0.0;
   int used=0;

   for(int dayOffset=0;
       dayOffset<RegimeSmoothingDays;
       dayOffset++)
   {
      double regimeFeatures[];
      double probabilities[];
      double dayDistance=0.0;

      if(!BuildRegimeFeatures(
         baseDayShift+dayOffset,
         regimeFeatures))
      {
         continue;
      }

      RegimeProbabilities(
         regimeFeatures,
         probabilities,
         dayDistance
      );

      if(used==0)
         distance=dayDistance;

      for(int state=0;state<REGIME_COUNT;state++)
         averaged[state]+=probabilities[state];

      used++;
   }

   if(used<=0)
      return(false);

   regime=0;
   probability=-1.0;

   for(int state2=0;state2<REGIME_COUNT;state2++)
   {
      averaged[state2]/=(double)used;

      if(averaged[state2]>probability)
      {
         probability=averaged[state2];
         regime=state2;
      }
   }

   return(true);
}

//+------------------------------------------------------------------+
//| Model banks                                                      |
//+------------------------------------------------------------------+
bool EvaluateStaticBanks(int shift,
                         int regime,
                         double &globalBuy,
                         double &globalSell,
                         double &specialBuy,
                         double &specialSell,
                         double &atr)
{
   double features[];

   if(!BuildFeatures(shift,features,atr))
      return(false);

   globalBuy=EvaluateAverageForest(
      features,50,
      GLOBAL_BUY_OFFSET,
      GLOBAL_BUY_FEATURE,
      GLOBAL_BUY_THRESHOLD,
      GLOBAL_BUY_LEFT,
      GLOBAL_BUY_RIGHT,
      GLOBAL_BUY_VALUE
   );

   globalSell=EvaluateAverageForest(
      features,50,
      GLOBAL_SELL_OFFSET,
      GLOBAL_SELL_FEATURE,
      GLOBAL_SELL_THRESHOLD,
      GLOBAL_SELL_LEFT,
      GLOBAL_SELL_RIGHT,
      GLOBAL_SELL_VALUE
   );

   if(regime==REGIME_BULL_EXPANSION)
   {
      specialBuy=EvaluateAverageForest(
         features,24,
         BULL_BUY_OFFSET,
         BULL_BUY_FEATURE,
         BULL_BUY_THRESHOLD,
         BULL_BUY_LEFT,
         BULL_BUY_RIGHT,
         BULL_BUY_VALUE
      );

      specialSell=EvaluateAverageForest(
         features,24,
         BULL_SELL_OFFSET,
         BULL_SELL_FEATURE,
         BULL_SELL_THRESHOLD,
         BULL_SELL_LEFT,
         BULL_SELL_RIGHT,
         BULL_SELL_VALUE
      );
   }
   else if(regime==REGIME_DISTRIBUTION)
   {
      specialBuy=EvaluateAverageForest(
         features,24,
         DIST_BUY_OFFSET,
         DIST_BUY_FEATURE,
         DIST_BUY_THRESHOLD,
         DIST_BUY_LEFT,
         DIST_BUY_RIGHT,
         DIST_BUY_VALUE
      );

      specialSell=EvaluateAverageForest(
         features,24,
         DIST_SELL_OFFSET,
         DIST_SELL_FEATURE,
         DIST_SELL_THRESHOLD,
         DIST_SELL_LEFT,
         DIST_SELL_RIGHT,
         DIST_SELL_VALUE
      );
   }
   else if(regime==REGIME_CORRECTION)
   {
      specialBuy=EvaluateAverageForest(
         features,24,
         CORR_BUY_OFFSET,
         CORR_BUY_FEATURE,
         CORR_BUY_THRESHOLD,
         CORR_BUY_LEFT,
         CORR_BUY_RIGHT,
         CORR_BUY_VALUE
      );

      specialSell=EvaluateAverageForest(
         features,24,
         CORR_SELL_OFFSET,
         CORR_SELL_FEATURE,
         CORR_SELL_THRESHOLD,
         CORR_SELL_LEFT,
         CORR_SELL_RIGHT,
         CORR_SELL_VALUE
      );
   }
   else
   {
      specialBuy=EvaluateAverageForest(
         features,24,
         RECV_BUY_OFFSET,
         RECV_BUY_FEATURE,
         RECV_BUY_THRESHOLD,
         RECV_BUY_LEFT,
         RECV_BUY_RIGHT,
         RECV_BUY_VALUE
      );

      specialSell=EvaluateAverageForest(
         features,24,
         RECV_SELL_OFFSET,
         RECV_SELL_FEATURE,
         RECV_SELL_THRESHOLD,
         RECV_SELL_LEFT,
         RECV_SELL_RIGHT,
         RECV_SELL_VALUE
      );
   }

   return(true);
}

//+------------------------------------------------------------------+
//| Causal historical outcome                                        |
//+------------------------------------------------------------------+
bool EvaluateKnownOutcome(int descriptorShift,
                          int direction,
                          double atr,
                          double &resultR)
{
   int entryShift=descriptorShift-1;
   int finalShift=entryShift-ExitHorizonBars+1;

   if(entryShift<1 || finalShift<1 || atr<=0.0)
      return(false);

   double entry=iOpen(NULL,PERIOD_H1,entryShift);
   double target=entry+
      direction*TakeProfitATR*atr;
   double stop=entry-
      direction*StopLossATR*atr;

   double exitPrice=0.0;
   bool closed=false;

   for(int step=0;step<ExitHorizonBars;step++)
   {
      int barShift=entryShift-step;

      if(barShift<1)
         return(false);

      double high=iHigh(NULL,PERIOD_H1,barShift);
      double low=iLow(NULL,PERIOD_H1,barShift);

      bool hitStop=(direction>0)
                   ?low<=stop
                   :high>=stop;

      bool hitTarget=(direction>0)
                     ?high>=target
                     :low<=target;

      // Conservative handling when both are inside one H1 candle.
      if(hitStop)
      {
         exitPrice=stop;
         closed=true;
         break;
      }

      if(hitTarget)
      {
         exitPrice=target;
         closed=true;
         break;
      }
   }

   if(!closed)
      exitPrice=iClose(NULL,PERIOD_H1,finalShift);

   double moneyResult=
      (exitPrice-entry)*direction-
      AssumedRoundTripCost;

   resultR=moneyResult/
           MathMax(StopLossATR*atr,Point);

   return(MathIsValidNumber(resultR));
}

//+------------------------------------------------------------------+
//| Online recent-outcome memory                                     |
//+------------------------------------------------------------------+
bool CalculateAdaptiveMemory(int descriptorShift,
                             int currentRegime,
                             double &buyEdge,
                             double &sellEdge,
                             double &effectiveN)
{
   buyEdge=0.0;
   sellEdge=0.0;
   effectiveN=0.0;

   double weightedBuy=0.0;
   double weightedSell=0.0;
   double weightSum=0.0;
   double weightSquaredSum=0.0;
   double ln2=MathLog(2.0);

   int firstDelta=ExitHorizonBars;
   int lastDelta=AdaptiveLookbackBars;

   for(int delta=firstDelta;
       delta<=lastDelta;
       delta++)
   {
      int pastDescriptorShift=descriptorShift+delta;

      if(pastDescriptorShift+260>=iBars(NULL,PERIOD_H1))
         break;

      int pastRegime=0;
      double pastProbability=0.0;
      double pastDistance=0.0;

      if(!CalculateRegimeForDescriptor(
         pastDescriptorShift,
         pastRegime,
         pastProbability,
         pastDistance))
      {
         continue;
      }

      if(pastRegime!=currentRegime)
         continue;

      double atr=iATR(
         NULL,PERIOD_H1,
         ATRPeriod,pastDescriptorShift
      );

      double buyResult=0.0;
      double sellResult=0.0;

      if(!EvaluateKnownOutcome(
         pastDescriptorShift,1,atr,buyResult))
      {
         continue;
      }

      if(!EvaluateKnownOutcome(
         pastDescriptorShift,-1,atr,sellResult))
      {
         continue;
      }

      double weight=MathExp(
         -ln2*(double)delta/
         MathMax(AdaptiveHalfLifeBars,1.0)
      );

      weightedBuy+=weight*buyResult;
      weightedSell+=weight*sellResult;
      weightSum+=weight;
      weightSquaredSum+=weight*weight;
   }

   if(weightSum<=0.0)
      return(false);

   buyEdge=weightedBuy/
           (weightSum+AdaptivePriorWeight);

   sellEdge=weightedSell/
            (weightSum+AdaptivePriorWeight);

   effectiveN=(weightSum*weightSum)/
              MathMax(weightSquaredSum,1.0e-9);

   return(true);
}

//+------------------------------------------------------------------+
//| Causal lower-timeframe motion intelligence                       |
//+------------------------------------------------------------------+
double ClampMotionValue(double value,double minimum,double maximum)
{
   return(MathMax(minimum,MathMin(maximum,value)));
}

//+------------------------------------------------------------------+
double SmoothMotionBound(double value)
{
   double bounded=ClampMotionValue(value,-10.0,10.0);
   return(2.0/(1.0+MathExp(-2.0*bounded))-1.0);
}

//+------------------------------------------------------------------+
double AverageTimeframeVolume(int timeframe,int startShift,int count)
{
   double total=0.0;
   int used=0;

   for(int shift=startShift;shift<startShift+count;shift++)
   {
      long value=iVolume(NULL,timeframe,shift);

      if(value>0)
      {
         total+=(double)value;
         used++;
      }
   }

   return(used>0 ? total/(double)used : 0.0);
}

//+------------------------------------------------------------------+
bool CalculateTimeframeMotion(int timeframe,
                              int anchorShift,
                              int lookback,
                              double &score)
{
   score=0.0;

   if(anchorShift<1 ||
      lookback<6 ||
      anchorShift+lookback+25>=iBars(NULL,timeframe))
   {
      return(false);
   }

   double atr=iATR(NULL,timeframe,14,anchorShift);
   double closeNow=iClose(NULL,timeframe,anchorShift);
   double closePast=iClose(NULL,timeframe,anchorShift+lookback);

   if(atr<=0.0 || closeNow<=0.0 || closePast<=0.0)
      return(false);

   int fastBars=3;
   double closeFastPast=iClose(NULL,timeframe,anchorShift+fastBars);
   double closePreviousFast=iClose(NULL,timeframe,anchorShift+2*fastBars);

   if(closeFastPast<=0.0 || closePreviousFast<=0.0)
      return(false);

   double normalizedVelocity=(closeNow-closePast)/atr;
   double recentVelocity=(closeNow-closeFastPast)/atr;
   double previousVelocity=(closeFastPast-closePreviousFast)/atr;
   double normalizedAcceleration=recentVelocity-previousVelocity;

   double absolutePath=0.0;

   for(int k=0;k<lookback;k++)
   {
      double newer=iClose(NULL,timeframe,anchorShift+k);
      double older=iClose(NULL,timeframe,anchorShift+k+1);

      if(newer<=0.0 || older<=0.0)
         return(false);

      absolutePath+=MathAbs(newer-older);
   }

   double netMove=closeNow-closePast;
   double persistence=MathAbs(netMove)/MathMax(absolutePath,Point);
   double signedPersistence=(netMove>0.0)
                            ?persistence
                            :(netMove<0.0 ? -persistence : 0.0);

   double openPrice=iOpen(NULL,timeframe,anchorShift);
   double highPrice=iHigh(NULL,timeframe,anchorShift);
   double lowPrice=iLow(NULL,timeframe,anchorShift);
   double range=highPrice-lowPrice;

   if(openPrice<=0.0 || range<=0.0)
      return(false);

   double pressure=2.0*(closeNow-lowPrice)/range-1.0;
   double upperWick=highPrice-MathMax(openPrice,closeNow);
   double lowerWick=MathMin(openPrice,closeNow)-lowPrice;
   double wickBalance=(lowerWick-upperWick)/range;

   double recentVolume=AverageTimeframeVolume(
      timeframe,anchorShift,3
   );
   double baselineVolume=AverageTimeframeVolume(
      timeframe,anchorShift+3,20
   );
   double volumeRatio=(baselineVolume>0.0)
                      ?recentVolume/baselineVolume
                      :1.0;
   double volumeQuality=ClampMotionValue(
      0.80+0.20*volumeRatio,0.85,1.15
   );

   double velocityComponent=SmoothMotionBound(
      normalizedVelocity/2.0
   );
   double accelerationComponent=SmoothMotionBound(
      normalizedAcceleration
   );

   score=(
      0.30*velocityComponent+
      0.25*accelerationComponent+
      0.20*ClampMotionValue(signedPersistence,-1.0,1.0)+
      0.15*ClampMotionValue(pressure,-1.0,1.0)+
      0.10*ClampMotionValue(wickBalance,-1.0,1.0)
   )*volumeQuality;

   score=ClampMotionValue(score,-1.0,1.0);
   return(MathIsValidNumber(score));
}

//+------------------------------------------------------------------+
bool CalculateLTFMotionForDescriptor(int descriptorShift,
                                     double &m5Score,
                                     double &m15Score,
                                     double &compositeScore,
                                     string &state)
{
   m5Score=0.0;
   m15Score=0.0;
   compositeScore=0.0;
   state="DATA UNAVAILABLE";

   int entryH1Shift=descriptorShift-1;

   if(entryH1Shift<0)
      return(false);

   datetime entryTime=iTime(NULL,PERIOD_H1,entryH1Shift);

   if(entryTime<=0)
      return(false);

   int m5EntryShift=iBarShift(
      NULL,PERIOD_M5,entryTime,false
   );
   int m15EntryShift=iBarShift(
      NULL,PERIOD_M15,entryTime,false
   );

   if(m5EntryShift<0 || m15EntryShift<0)
      return(false);

   // Skip the LTF candle opening at entryTime. Only candles that were
   // fully closed before the H1 entry are allowed into the motion score.
   int m5Anchor=m5EntryShift+1;
   int m15Anchor=m15EntryShift+1;

   datetime m5AnchorTime=iTime(
      NULL,PERIOD_M5,m5Anchor
   );
   datetime m15AnchorTime=iTime(
      NULL,PERIOD_M15,m15Anchor
   );

   if(m5AnchorTime<=0 || m15AnchorTime<=0)
      return(false);

   double m5AgeSeconds=(double)(entryTime-m5AnchorTime);
   double m15AgeSeconds=(double)(entryTime-m15AnchorTime);

   if(m5AgeSeconds>
      LTFMaximumAgeMultiplier*PERIOD_M5*60.0 ||
      m15AgeSeconds>
      LTFMaximumAgeMultiplier*PERIOD_M15*60.0)
   {
      state="STALE LTF DATA";
      return(false);
   }

   if(!CalculateTimeframeMotion(
      PERIOD_M5,m5Anchor,LTFM5LookbackBars,m5Score))
   {
      return(false);
   }

   if(!CalculateTimeframeMotion(
      PERIOD_M15,m15Anchor,LTFM15LookbackBars,m15Score))
   {
      return(false);
   }

   double weightTotal=LTFM5Weight+LTFM15Weight;

   if(weightTotal<=0.0)
      return(false);

   compositeScore=(
      LTFM5Weight*m5Score+
      LTFM15Weight*m15Score
   )/weightTotal;

   bool conflict=(m5Score*m15Score<0.0 &&
                  MathAbs(m5Score-m15Score)>0.25);

   if(conflict)
      compositeScore*=0.65;

   compositeScore=ClampMotionValue(
      compositeScore,-1.0,1.0
   );

   if(conflict)
      state="M5/M15 CONFLICT";
   else if(compositeScore>=0.25)
      state="BULL ACCELERATION";
   else if(compositeScore>=0.08)
      state="BULL PRESSURE";
   else if(compositeScore<=-0.25)
      state="BEAR ACCELERATION";
   else if(compositeScore<=-0.08)
      state="BEAR PRESSURE";
   else
      state="NEUTRAL MOTION";

   return(true);
}

//+------------------------------------------------------------------+
//| Vote helpers                                                     |
//+------------------------------------------------------------------+
int EdgeVote(double buyEdge,double sellEdge)
{
   double selected=MathMax(buyEdge,sellEdge);
   double separation=MathAbs(buyEdge-sellEdge);

   if(selected<=StaticVoteMinimumEdge ||
      separation<StaticVoteMinimumSeparation)
   {
      return(0);
   }

   return(buyEdge>=sellEdge ? 1 : -1);
}

//+------------------------------------------------------------------+
int AdaptiveEdgeVote(double buyEdge,double sellEdge)
{
   double selected=MathMax(buyEdge,sellEdge);
   double separation=MathAbs(buyEdge-sellEdge);

   if(selected<CoreAdaptiveMinimumEdge ||
      separation<AdaptiveVoteMinimumSeparation)
   {
      return(0);
   }

   return(buyEdge>=sellEdge ? 1 : -1);
}

//+------------------------------------------------------------------+
int MajorityDirection(int globalVote,
                      int specialVote,
                      int adaptiveVote)
{
   int buyVotes=0;
   int sellVotes=0;

   if(globalVote>0)
      buyVotes++;
   else if(globalVote<0)
      sellVotes++;

   if(specialVote>0)
      buyVotes++;
   else if(specialVote<0)
      sellVotes++;

   if(adaptiveVote>0)
      buyVotes++;
   else if(adaptiveVote<0)
      sellVotes++;

   if(buyVotes>=2 && buyVotes>sellVotes)
      return(1);

   if(sellVotes>=2 && sellVotes>buyVotes)
      return(-1);

   return(0);
}

//+------------------------------------------------------------------+
double SelectedEdge(int direction,
                    double buyEdge,
                    double sellEdge)
{
   return(direction>0 ? buyEdge : sellEdge);
}

//+------------------------------------------------------------------+
//| Complete adaptive council                                        |
//+------------------------------------------------------------------+
bool EvaluateCouncil(int shift,
                     int &regime,
                     double &regimeProbability,
                     double &regimeDistance,
                     double &globalBuy,
                     double &globalSell,
                     double &specialBuy,
                     double &specialSell,
                     double &adaptiveBuy,
                     double &adaptiveSell,
                     double &adaptiveN,
                     double &ltfM5Score,
                     double &ltfM15Score,
                     double &ltfCompositeScore,
                     double &ltfAlignment,
                     bool &ltfAvailable,
                     string &ltfState,
                     int &globalVote,
                     int &specialVote,
                     int &adaptiveVote,
                     int &coreDirection,
                     int &primeDirection,
                     double &combinedEdge,
                     double &atr,
                     string &reason)
{
   reason="WAITING";
   coreDirection=0;
   primeDirection=0;
   adaptiveVote=0;
   combinedEdge=0.0;
   ltfM5Score=0.0;
   ltfM15Score=0.0;
   ltfCompositeScore=0.0;
   ltfAlignment=0.0;
   ltfAvailable=false;
   ltfState=EnableLTFMotionEngine
            ?"NOT EVALUATED"
            :"DISABLED";

   if(!CalculateRegimeForDescriptor(
      shift,
      regime,
      regimeProbability,
      regimeDistance))
   {
      reason="REGIME UNAVAILABLE";
      return(false);
   }

   if(!EvaluateStaticBanks(
      shift,regime,
      globalBuy,globalSell,
      specialBuy,specialSell,
      atr))
   {
      reason="MODEL FEATURES UNAVAILABLE";
      return(false);
   }

   CalculateAdaptiveMemory(
      shift,regime,
      adaptiveBuy,adaptiveSell,
      adaptiveN
   );

   globalVote=EdgeVote(globalBuy,globalSell);
   specialVote=EdgeVote(specialBuy,specialSell);

   if(adaptiveN>=MinimumAdaptiveEffectiveN &&
      MathMax(adaptiveBuy,adaptiveSell)>
      CoreAdaptiveMinimumEdge)
   {
      adaptiveVote=AdaptiveEdgeVote(adaptiveBuy,adaptiveSell);
   }

   int majority=MajorityDirection(
      globalVote,
      specialVote,
      adaptiveVote
   );

   double noveltyRatio=
      regimeDistance/
      MathMax(RegimeDistanceP95,1.0e-9);

   if(EnableLTFMotionEngine)
   {
      ltfAvailable=CalculateLTFMotionForDescriptor(
         shift,
         ltfM5Score,
         ltfM15Score,
         ltfCompositeScore,
         ltfState
      );

      if(ltfAvailable && majority!=0)
         ltfAlignment=majority*ltfCompositeScore;
   }

   if(regime==REGIME_RECOVERY &&
      !AllowRecoverySignals)
   {
      reason="RECOVERY HYSTERESIS VETO";
      return(true);
   }

   if(regimeProbability<MinimumRegimeProbability)
   {
      reason="REGIME PROBABILITY TOO LOW";
      return(true);
   }

   if(noveltyRatio>MaximumNoveltyRatio)
   {
      reason="STRUCTURAL BREAK VETO";
      return(true);
   }

   if(majority==0)
   {
      reason="NO CONFIDENT H1 CONSENSUS";
      return(true);
   }

   if(EnableLTFMotionEngine &&
      !ltfAvailable &&
      LTFRequireData)
   {
      reason="LTF MOTION DATA UNAVAILABLE";
      return(true);
   }

   if(EnableLTFMotionEngine &&
      ltfAvailable &&
      ltfAlignment<LTFHardVetoAlignment)
   {
      combinedEdge=
         GlobalBankWeight*SelectedEdge(
            majority,globalBuy,globalSell)+
         SpecialistBankWeight*SelectedEdge(
            majority,specialBuy,specialSell)+
         AdaptiveMemoryWeight*SelectedEdge(
            majority,adaptiveBuy,adaptiveSell)+
         LTFEdgeWeight*ltfAlignment;
      reason="LTF MOTION HARD VETO";
      return(true);
   }

   double selectedGlobal=
      SelectedEdge(majority,globalBuy,globalSell);

   double selectedSpecial=
      SelectedEdge(majority,specialBuy,specialSell);

   double selectedAdaptive=
      SelectedEdge(majority,adaptiveBuy,adaptiveSell);

   if(MathMax(selectedGlobal,selectedSpecial)<
      MinimumStaticBankEdge)
   {
      reason="STATIC BANK EDGE TOO WEAK";
      return(true);
   }

   combinedEdge=
      GlobalBankWeight*selectedGlobal+
      SpecialistBankWeight*selectedSpecial+
      AdaptiveMemoryWeight*selectedAdaptive;

   if(EnableLTFMotionEngine && ltfAvailable)
      combinedEdge+=LTFEdgeWeight*ltfAlignment;

   double penalty=
      MathMax(0.0,noveltyRatio-1.0)*
      NoveltyPenaltyWeight+
      MathMax(0.0,
         RegimeProbabilityPenaltyStart-
         regimeProbability)*
      RegimeProbabilityPenaltyWeight;

   if(combinedEdge>CoreCombinedEdge+penalty)
      coreDirection=majority;

   int primeAdaptiveVote=0;

   if(adaptiveN>=MinimumAdaptiveEffectiveN &&
      MathMax(adaptiveBuy,adaptiveSell)>
      PrimeAdaptiveMinimumEdge)
   {
      primeAdaptiveVote=AdaptiveEdgeVote(adaptiveBuy,adaptiveSell);
   }

   int primeMajority=MajorityDirection(
      globalVote,
      specialVote,
      primeAdaptiveVote
   );

   bool ltfPrimePassed=(
      !EnableLTFMotionEngine ||
      (!ltfAvailable && !LTFRequireData) ||
      (ltfAvailable &&
       ltfAlignment>=LTFMinimumPrimeAlignment)
   );

   if(primeMajority==majority &&
      combinedEdge>PrimeCombinedEdge+penalty &&
      ltfPrimePassed)
   {
      primeDirection=majority;
      reason="PRIME EDGE + LTF MOTION PASSED";
   }
   else if(coreDirection!=0 && !ltfPrimePassed)
   {
      reason="CORE ONLY - LTF MOTION NOT CONFIRMED";
   }
   else if(coreDirection!=0)
   {
      reason="CORE ONLY - PRIME EDGE NOT MET";
   }
   else
   {
      reason="COMBINED EDGE BELOW THRESHOLD";
   }

   return(true);
}

//+------------------------------------------------------------------+
//| Persistent cooldown                                              |
//+------------------------------------------------------------------+
bool PersistentCooldownPassed(datetime signalTime)
{
   if(!PersistCooldownAcrossSessions)
      return(true);

   if(!GlobalVariableCheck(STATE_KEY))
      return(true);

   datetime lastSignal=
      (datetime)GlobalVariableGet(STATE_KEY);

   if(lastSignal<=0)
      return(true);

   int lastShift=iBarShift(
      NULL,PERIOD_H1,lastSignal,false
   );

   int currentShift=iBarShift(
      NULL,PERIOD_H1,signalTime,false
   );

   if(lastShift<0 || currentShift<0)
      return(true);

   return((lastShift-currentShift)>=CooldownBars);
}

//+------------------------------------------------------------------+
void SavePersistentSignal(datetime signalTime)
{
   if(!PersistCooldownAcrossSessions)
      return;

   GlobalVariableSet(STATE_KEY,(double)signalTime);
}

//+------------------------------------------------------------------+
//| Version 9 operational truth and persistent evidence              |
//+------------------------------------------------------------------+
string V9StateKey(string suffix)
{
   string key=g_statePrefix+suffix;

   if(StringLen(key)>63)
      key=StringSubstr(key,0,63);

   return(key);
}

//+------------------------------------------------------------------+
string LifecycleText(int state)
{
   if(state==LIFE_ARMED)
      return("ARMED");
   if(state==LIFE_ACTIVE)
      return("ACTIVE");
   if(state==LIFE_COMPLETED_TP)
      return("COMPLETED TP");
   if(state==LIFE_COMPLETED_SL)
      return("COMPLETED SL");
   if(state==LIFE_EXPIRED)
      return("EXPIRED");
   if(state==LIFE_INVALIDATED)
      return("INVALIDATED");
   if(state==LIFE_MISSED)
      return("MISSED");

   return("IDLE");
}

//+------------------------------------------------------------------+
double CurrentMarketPrice(int direction)
{
   // Entry-side quote: BUY enters at Ask, SELL enters at Bid.
   if(direction>0 && Ask>0.0)
      return(Ask);
   if(direction<0 && Bid>0.0)
      return(Bid);
   if(Bid>0.0)
      return(Bid);

   return(iClose(NULL,PERIOD_H1,0));
}

//+------------------------------------------------------------------+
double CurrentExitMarketPrice(int direction)
{
   // Liquidation-side quote: BUY exits at Bid, SELL exits at Ask.
   if(direction>0 && Bid>0.0)
      return(Bid);
   if(direction<0 && Ask>0.0)
      return(Ask);
   if(Bid>0.0)
      return(Bid);

   return(iClose(NULL,PERIOD_H1,0));
}

//+------------------------------------------------------------------+
double EntryDeviationATR(int direction,
                         double testedEntry,
                         double currentPrice,
                         double atr)
{
   if(direction==0 || testedEntry<=0.0 ||
      currentPrice<=0.0 || atr<=0.0)
   {
      return(0.0);
   }

   return(direction*(currentPrice-testedEntry)/atr);
}

//+------------------------------------------------------------------+
string EntryValidityText(int direction,
                         double testedEntry,
                         double currentPrice,
                         double atr,
                         bool armed)
{
   if(direction==0 || testedEntry<=0.0 ||
      currentPrice<=0.0 || atr<=0.0)
   {
      return("WAITING");
   }

   double deviation=EntryDeviationATR(
      direction,testedEntry,currentPrice,atr
   );

   if(armed)
   {
      bool reached=(direction>0)
                   ?currentPrice>=testedEntry
                   :currentPrice<=testedEntry;

      if(!reached)
         return("PENDING");
   }

   if(deviation>EntryExtendedDeviationATR)
      return("MISSED");

   if(deviation>EntryValidDeviationATR)
      return("EXTENDED");

   if(deviation<-StopLossATR)
      return("INVALIDATED");

   return("VALID");
}

//+------------------------------------------------------------------+
int ReputationIndex(int bank,int regime,int direction)
{
   int safeBank=MathMax(0,MathMin(BANK_COUNT-1,bank));
   int safeRegime=MathMax(0,MathMin(REGIME_COUNT-1,regime));
   int side=(direction>0)?0:1;
   return(safeBank*REGIME_COUNT*2+safeRegime*2+side);
}

//+------------------------------------------------------------------+
string ReputationBankLabel(int bank)
{
   if(bank==BANK_GLOBAL)
      return("G");
   if(bank==BANK_SPECIALIST)
      return("SP");
   if(bank==BANK_ADAPTIVE)
      return("A");

   return("LTF");
}

//+------------------------------------------------------------------+
double ReputationMultiplier(int bank,int regime,int direction)
{
   if(!EnableReputationWeighting || direction==0)
      return(1.0);

   int index=ReputationIndex(bank,regime,direction);
   double n=g_repN[index];

   if(n<MinimumReputationSamples)
      return(1.0);

   double shrunkMean=g_repSumR[index]/
      MathMax(n+ReputationPriorSamples,1.0);
   double multiplier=1.0+
      ReputationInfluence*
      ClampMotionValue(shrunkMean,-0.75,0.75);

   return(ClampMotionValue(
      multiplier,
      MinimumReputationMultiplier,
      MaximumReputationMultiplier
   ));
}

//+------------------------------------------------------------------+
void SaveReputationState()
{
   for(int index=0;index<32;index++)
   {
      string suffix=IntegerToString(index);
      GlobalVariableSet(V9StateKey("RN"+suffix),g_repN[index]);
      GlobalVariableSet(V9StateKey("RW"+suffix),g_repWins[index]);
      GlobalVariableSet(V9StateKey("RR"+suffix),g_repSumR[index]);
      GlobalVariableSet(V9StateKey("RP"+suffix),g_repPositiveR[index]);
      GlobalVariableSet(V9StateKey("RL"+suffix),g_repNegativeR[index]);
   }
}

//+------------------------------------------------------------------+
void LoadReputationState()
{
   for(int index=0;index<32;index++)
   {
      string suffix=IntegerToString(index);
      string key=V9StateKey("RN"+suffix);
      if(GlobalVariableCheck(key))
         g_repN[index]=GlobalVariableGet(key);

      key=V9StateKey("RW"+suffix);
      if(GlobalVariableCheck(key))
         g_repWins[index]=GlobalVariableGet(key);

      key=V9StateKey("RR"+suffix);
      if(GlobalVariableCheck(key))
         g_repSumR[index]=GlobalVariableGet(key);

      key=V9StateKey("RP"+suffix);
      if(GlobalVariableCheck(key))
         g_repPositiveR[index]=GlobalVariableGet(key);

      key=V9StateKey("RL"+suffix);
      if(GlobalVariableCheck(key))
         g_repNegativeR[index]=GlobalVariableGet(key);
   }
}

//+------------------------------------------------------------------+
void UpdateBankReputation(int bank,
                          int regime,
                          int predictedDirection,
                          int releasedDirection,
                          double resultR)
{
   if(predictedDirection==0 || releasedDirection==0)
      return;

   int index=ReputationIndex(
      bank,regime,predictedDirection
   );
   double bankResult=(predictedDirection==releasedDirection)
                     ?resultR
                     :-resultR;

   g_repN[index]+=1.0;
   g_repSumR[index]+=bankResult;

   if(bankResult>0.0)
   {
      g_repWins[index]+=1.0;
      g_repPositiveR[index]+=bankResult;
   }
   else
   {
      g_repNegativeR[index]+=bankResult;
   }
}

//+------------------------------------------------------------------+
void UpdateReputationAfterOutcome(double resultR)
{
   UpdateBankReputation(
      BANK_GLOBAL,g_tradeRegime,g_tradeGlobalCall,
      g_tradeDirection,resultR
   );
   UpdateBankReputation(
      BANK_SPECIALIST,g_tradeRegime,g_tradeSpecialCall,
      g_tradeDirection,resultR
   );
   UpdateBankReputation(
      BANK_ADAPTIVE,g_tradeRegime,g_tradeAdaptiveCall,
      g_tradeDirection,resultR
   );
   UpdateBankReputation(
      BANK_LTF,g_tradeRegime,g_tradeLTFCall,
      g_tradeDirection,resultR
   );
   SaveReputationState();
}

//+------------------------------------------------------------------+
void UpdateProductionPerformance(double resultR)
{
   double alpha=2.0/(MathMax(2,DriftEWMAWindow)+1.0);
   double clipped=ClampMotionValue(resultR,-1.0,1.0);
   double error=(resultR<0.0)
                ?MathMin(1.0,MathAbs(resultR))
                :0.0;

   if(g_completedProductionSignals<=0)
   {
      g_productionOutcomeEWMA=clipped;
      g_predictionErrorEWMA=error;
   }
   else
   {
      g_productionOutcomeEWMA=
         (1.0-alpha)*g_productionOutcomeEWMA+
         alpha*clipped;
      g_predictionErrorEWMA=
         (1.0-alpha)*g_predictionErrorEWMA+
         alpha*error;
   }

   g_completedProductionSignals++;
}

//+------------------------------------------------------------------+
void UpdateDriftMonitor()
{
   double noveltyComponent=ClampMotionValue(
      (g_noveltyRatio-0.75)/
      MathMax(MaximumNoveltyRatio-0.75,0.10),
      0.0,1.25
   );

   double disagreement=0.0;
   double activeWeight=g_weightedBuy+g_weightedSell;

   if(activeWeight>0.0)
      disagreement=1.0-
         MathMax(g_weightedBuy,g_weightedSell)/activeWeight;

   disagreement=ClampMotionValue(
      disagreement*2.0,0.0,1.0
   );

   double performanceStress=ClampMotionValue(
      0.65*g_predictionErrorEWMA+
      0.35*MathMax(0.0,-g_productionOutcomeEWMA),
      0.0,1.0
   );

   double shadowGap=0.0;
   if(g_shadowTrades>=5)
      shadowGap=ClampMotionValue(
         g_shadowMeanR-g_productionOutcomeEWMA,
         0.0,1.0
      );

   g_driftScore=
      0.45*noveltyComponent+
      0.25*performanceStress+
      0.20*disagreement+
      0.10*shadowGap;

   if(g_noveltyRatio>MaximumNoveltyRatio)
      g_driftScore=MathMax(g_driftScore,DriftSuspendThreshold);

   if(g_driftScore>=DriftSuspendThreshold)
      g_driftState="TRADING SUSPENDED";
   else if(g_driftScore>=DriftDegradedThreshold)
      g_driftState="MODEL DEGRADED";
   else if(g_driftScore>=DriftSuspectedThreshold)
      g_driftState="DRIFT SUSPECTED";
   else if(g_driftScore>=DriftWatchThreshold)
      g_driftState="WATCH";
   else
      g_driftState="NORMAL";
}

//+------------------------------------------------------------------+
bool SevereDriftVeto()
{
   if(!SuspendSignalsOnSevereDrift)
      return(false);

   return(g_driftScore>=DriftSuspendThreshold ||
          g_noveltyRatio>MaximumNoveltyRatio);
}

//+------------------------------------------------------------------+
string BuildEvidenceFileName()
{
   string symbolName=Symbol();
   string tag=EvidenceFileTag;
   StringReplace(symbolName,"\\","_");
   StringReplace(symbolName,"/","_");
   StringReplace(symbolName,":","_");
   StringReplace(tag,"\\","_");
   StringReplace(tag,"/","_");
   StringReplace(tag,":","_");

   return("XVISION_"+tag+"_"+symbolName+"_H1_evidence.csv");
}

//+------------------------------------------------------------------+
void EnsureEvidenceLedger()
{
   if(!EnableEvidenceLogging || StringLen(g_evidenceFileName)<=0)
      return;

   bool exists=FileIsExist(g_evidenceFileName,FILE_COMMON);
   int handle=FileOpen(
      g_evidenceFileName,
      FILE_READ|FILE_WRITE|FILE_CSV|FILE_COMMON,
      ';'
   );

   if(handle==INVALID_HANDLE)
   {
      Print("XVISION V12: evidence ledger open failed. Error ",
            GetLastError());
      ResetLastError();
      return;
   }

   if(!exists || FileSize(handle)<=0)
   {
      FileWrite(
         handle,
         "event_time","event_type","status","signal_id",
         "symbol","timeframe","regime","regime_probability",
         "novelty_ratio","drift_state","drift_score",
         "global_call","specialist_call","adaptive_call","ltf_call",
         "global_buy_r","global_sell_r",
         "specialist_buy_r","specialist_sell_r",
         "adaptive_buy_r","adaptive_sell_r","adaptive_n",
         "ltf_m5","ltf_m15","ltf_composite",
         "weighted_buy","weighted_sell","buy_share","sell_share",
         "live_route_direction","live_route_confidence",
         "release_buy_share","release_sell_share",
         "route","direction","tested_entry","actual_entry","available_price",
         "deviation_atr","entry_validity","target","stop",
         "mfe_atr","mae_atr","age_bars","result_r",
         "shadow_flag","notes"
      );
      FileFlush(handle);
   }

   FileClose(handle);
}

//+------------------------------------------------------------------+
void AppendEvidenceEvent(string eventType,
                         string status,
                         int direction,
                         double testedEntry,
                         double resultR)
{
   if(!EnableEvidenceLogging || StringLen(g_evidenceFileName)<=0)
      return;

   EnsureEvidenceLedger();
   int handle=FileOpen(
      g_evidenceFileName,
      FILE_READ|FILE_WRITE|FILE_CSV|FILE_COMMON,
      ';'
   );

   if(handle==INVALID_HANDLE)
      return;

   FileSeek(handle,0,SEEK_END);

   bool lifecycleEvidence=(
      g_tradeActive ||
      g_evidenceShadowContext ||
      StringFind(eventType,"LIFECYCLE",0)==0 ||
      StringFind(eventType,"SHADOW",0)==0
   );
   double currentPrice=lifecycleEvidence
                       ?CurrentExitMarketPrice(direction)
                       :CurrentMarketPrice(direction);
   double atr=(lifecycleEvidence && g_tradeATRAtEntry>0.0)
              ?g_tradeATRAtEntry
              :g_liveATR;
   double evidenceActualEntry=(lifecycleEvidence &&
                               g_tradeActualEntry>0.0)
                              ?g_tradeActualEntry
                              :0.0;
   double executionEntry=(evidenceActualEntry>0.0)
                         ?evidenceActualEntry
                         :testedEntry;
   double deviation=EntryDeviationATR(
      direction,executionEntry,currentPrice,atr
   );
   string validity="WAITING";

   if(g_tradeActive && lifecycleEvidence)
      validity="ACTIVE";
   else if(StringFind(eventType,"LIFECYCLE_CLOSE",0)==0)
      validity=LifecycleText(g_lifecycleState);
   else
      validity=EntryValidityText(
         direction,testedEntry,currentPrice,atr,
         g_consensusArmed
      );
   int ageBars=0;
   string evidenceRoute=(
      StringLen(g_tradeRoute)>0 &&
      (g_tradeActive || g_lifecycleState>=LIFE_COMPLETED_TP)
   )?g_tradeRoute:g_consensusRoute;

   if(g_tradeEntryTime>0)
   {
      int calculatedAge=iBarShift(
         NULL,PERIOD_H1,g_tradeEntryTime,false
      );
      if(calculatedAge>0)
         ageBars=calculatedAge;
   }

   FileWrite(
      handle,
      TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS),
      eventType,status,
      DoubleToString((double)g_signalId,0),
      Symbol(),"H1",RegimeText(g_regime),
      DoubleToString(g_regimeProbability,6),
      DoubleToString(g_noveltyRatio,6),
      g_driftState,DoubleToString(g_driftScore,6),
      IntegerToString(g_globalCallDirection),
      IntegerToString(g_specialCallDirection),
      IntegerToString(g_adaptiveCallDirection),
      IntegerToString(g_ltfCallDirection),
      DoubleToString(g_globalBuy,6),
      DoubleToString(g_globalSell,6),
      DoubleToString(g_specialBuy,6),
      DoubleToString(g_specialSell,6),
      DoubleToString(g_adaptiveBuy,6),
      DoubleToString(g_adaptiveSell,6),
      DoubleToString(g_adaptiveN,3),
      DoubleToString(g_ltfM5Score,6),
      DoubleToString(g_ltfM15Score,6),
      DoubleToString(g_ltfCompositeScore,6),
      DoubleToString(g_weightedBuy,6),
      DoubleToString(g_weightedSell,6),
      DoubleToString(g_weightedBuyShare,6),
      DoubleToString(g_weightedSellShare,6),
      IntegerToString(g_liveCouncilDirection),
      DoubleToString(g_liveCouncilConfidence,6),
      DoubleToString(g_tradeReleaseBuyShare,6),
      DoubleToString(g_tradeReleaseSellShare,6),
      evidenceRoute,IntegerToString(direction),
      DoubleToString(testedEntry,Digits),
      DoubleToString(evidenceActualEntry,Digits),
      DoubleToString(currentPrice,Digits),
      DoubleToString(deviation,6),validity,
      DoubleToString(g_tradeTarget,Digits),
      DoubleToString(g_tradeStop,Digits),
      DoubleToString(g_tradeMFEATR,6),
      DoubleToString(g_tradeMAEATR,6),
      IntegerToString(ageBars),
      DoubleToString(resultR,6),
      g_evidenceShadowContext?"1":"0",g_tradeExitReason
   );
   FileFlush(handle);
   FileClose(handle);
}

//+------------------------------------------------------------------+
void AppendShadowEvidence(string eventType,
                          string status,
                          double resultR)
{
   if(!EnableEvidenceLogging)
      return;

   int productionDirection=g_tradeDirection;
   double productionEntry=g_tradeEntry;
   double productionActualEntry=g_tradeActualEntry;
   double productionTarget=g_tradeTarget;
   double productionStop=g_tradeStop;
   double productionMFE=g_tradeMFEATR;
   double productionMAE=g_tradeMAEATR;
   double productionATR=g_tradeATRAtEntry;
   datetime productionTime=g_tradeEntryTime;
   string productionReason=g_tradeExitReason;
   long productionId=g_signalId;

   g_tradeDirection=g_shadowDirection;
   g_tradeEntry=g_shadowEntry;
   g_tradeActualEntry=g_shadowEntry;
   g_tradeTarget=g_shadowTarget;
   g_tradeStop=g_shadowStop;
   g_tradeMFEATR=g_shadowMFEATR;
   g_tradeMAEATR=g_shadowMAEATR;
   g_tradeATRAtEntry=g_shadowATR;
   g_tradeEntryTime=g_shadowEntryTime;
   g_tradeExitReason="SHADOW "+status;
   g_signalId=(long)g_shadowEntryTime;
   g_evidenceShadowContext=true;

   AppendEvidenceEvent(
      eventType,status,g_shadowDirection,
      g_shadowEntry,resultR
   );
   g_evidenceShadowContext=false;

   g_tradeDirection=productionDirection;
   g_tradeEntry=productionEntry;
   g_tradeActualEntry=productionActualEntry;
   g_tradeTarget=productionTarget;
   g_tradeStop=productionStop;
   g_tradeMFEATR=productionMFE;
   g_tradeMAEATR=productionMAE;
   g_tradeATRAtEntry=productionATR;
   g_tradeEntryTime=productionTime;
   g_tradeExitReason=productionReason;
   g_signalId=productionId;
}

//+------------------------------------------------------------------+
void SaveV9PersistentState()
{
   if(PersistLifecycleAcrossSessions)
   {
      GlobalVariableSet(V9StateKey("LC"),g_lifecycleState);
      GlobalVariableSet(V9StateKey("SID"),(double)g_signalId);
      GlobalVariableSet(V9StateKey("TA"),g_tradeActive?1.0:0.0);
      GlobalVariableSet(V9StateKey("TD"),g_tradeDirection);
      GlobalVariableSet(V9StateKey("TE"),g_tradeEntry);
      GlobalVariableSet(V9StateKey("TX"),g_tradeActualEntry);
      GlobalVariableSet(V9StateKey("TT"),g_tradeTarget);
      GlobalVariableSet(V9StateKey("TS"),g_tradeStop);
      GlobalVariableSet(V9StateKey("TM"),(double)g_tradeEntryTime);
      GlobalVariableSet(V9StateKey("TR"),g_tradeRegime);
      GlobalVariableSet(V9StateKey("TATR"),g_tradeATRAtEntry);
      GlobalVariableSet(V9StateKey("TMFE"),g_tradeMFEATR);
      GlobalVariableSet(V9StateKey("TMAE"),g_tradeMAEATR);
      GlobalVariableSet(V9StateKey("TRES"),g_tradeResultR);
      GlobalVariableSet(V9StateKey("TEX"),g_tradeExitPrice);
      GlobalVariableSet(V9StateKey("TET"),(double)g_tradeExitTime);
      GlobalVariableSet(V9StateKey("TG"),g_tradeGlobalCall);
      GlobalVariableSet(V9StateKey("TSP"),g_tradeSpecialCall);
      GlobalVariableSet(V9StateKey("TAD"),g_tradeAdaptiveCall);
      GlobalVariableSet(V9StateKey("TLT"),g_tradeLTFCall);
      GlobalVariableSet(V9StateKey("TRB"),g_tradeReleaseBuyShare);
      GlobalVariableSet(V9StateKey("TRS"),g_tradeReleaseSellShare);
      GlobalVariableSet(V9StateKey("CA"),g_consensusArmed?1.0:0.0);
      GlobalVariableSet(V9StateKey("CD"),g_consensusDirection);
      GlobalVariableSet(V9StateKey("CP"),g_consensusPrice);
      GlobalVariableSet(V9StateKey("CC"),g_consensusConfidence);
      GlobalVariableSet(V9StateKey("CT"),(double)g_consensusCreated);
      GlobalVariableSet(V9StateKey("PE"),g_productionOutcomeEWMA);
      GlobalVariableSet(V9StateKey("EE"),g_predictionErrorEWMA);
      GlobalVariableSet(V9StateKey("PC"),g_completedProductionSignals);
   }

   if(PersistShadowAcrossSessions)
   {
      GlobalVariableSet(V9StateKey("SHA"),g_shadowActive?1.0:0.0);
      GlobalVariableSet(V9StateKey("SHD"),g_shadowDirection);
      GlobalVariableSet(V9StateKey("SHE"),g_shadowEntry);
      GlobalVariableSet(V9StateKey("SHT"),g_shadowTarget);
      GlobalVariableSet(V9StateKey("SHS"),g_shadowStop);
      GlobalVariableSet(V9StateKey("SHR"),g_shadowATR);
      GlobalVariableSet(V9StateKey("SHM"),(double)g_shadowEntryTime);
      GlobalVariableSet(V9StateKey("SHG"),g_shadowRegime);
      GlobalVariableSet(V9StateKey("SHF"),g_shadowMFEATR);
      GlobalVariableSet(V9StateKey("SHQ"),g_shadowMAEATR);
      GlobalVariableSet(V9StateKey("SHN"),g_shadowTrades);
      GlobalVariableSet(V9StateKey("SHW"),g_shadowWins);
      GlobalVariableSet(V9StateKey("SHP"),g_shadowPositiveR);
      GlobalVariableSet(V9StateKey("SHL"),g_shadowNegativeR);
   }
}

//+------------------------------------------------------------------+
double LoadV9Value(string suffix,double fallback)
{
   string key=V9StateKey(suffix);
   return(GlobalVariableCheck(key)
          ?GlobalVariableGet(key)
          :fallback);
}

//+------------------------------------------------------------------+
void LoadV9PersistentState()
{
   LoadReputationState();

   if(PersistLifecycleAcrossSessions)
   {
      g_lifecycleState=(int)LoadV9Value("LC",LIFE_IDLE);
      g_signalId=(long)LoadV9Value("SID",0.0);
      g_tradeActive=(LoadV9Value("TA",0.0)>0.5);
      g_tradeDirection=(int)LoadV9Value("TD",0.0);
      g_tradeEntry=LoadV9Value("TE",0.0);
      g_tradeActualEntry=LoadV9Value("TX",0.0);
      g_tradeTarget=LoadV9Value("TT",0.0);
      g_tradeStop=LoadV9Value("TS",0.0);
      g_tradeEntryTime=(datetime)LoadV9Value("TM",0.0);
      g_tradeRegime=(int)LoadV9Value("TR",0.0);
      g_tradeATRAtEntry=LoadV9Value("TATR",0.0);
      g_tradeMFEATR=LoadV9Value("TMFE",0.0);
      g_tradeMAEATR=LoadV9Value("TMAE",0.0);
      g_tradeResultR=LoadV9Value("TRES",0.0);
      g_tradeExitPrice=LoadV9Value("TEX",0.0);
      g_tradeExitTime=(datetime)LoadV9Value("TET",0.0);
      g_tradeGlobalCall=(int)LoadV9Value("TG",0.0);
      g_tradeSpecialCall=(int)LoadV9Value("TSP",0.0);
      g_tradeAdaptiveCall=(int)LoadV9Value("TAD",0.0);
      g_tradeLTFCall=(int)LoadV9Value("TLT",0.0);
      g_tradeReleaseBuyShare=LoadV9Value("TRB",0.0);
      g_tradeReleaseSellShare=LoadV9Value("TRS",0.0);
      g_consensusArmed=(LoadV9Value("CA",0.0)>0.5);
      g_consensusDirection=(int)LoadV9Value("CD",0.0);
      g_consensusPrice=LoadV9Value("CP",0.0);
      g_consensusConfidence=LoadV9Value("CC",0.0);
      g_consensusCreated=(datetime)LoadV9Value("CT",0.0);
      g_productionOutcomeEWMA=LoadV9Value("PE",0.0);
      g_predictionErrorEWMA=LoadV9Value("EE",0.0);
      g_completedProductionSignals=(int)LoadV9Value("PC",0.0);
      g_tradeState=LifecycleText(g_lifecycleState);
      g_tradeRoute=g_tradeActive
                   ?"RESTORED ACTIVE SIGNAL"
                   :"";
      g_tradeExitReason=(!g_tradeActive &&
                         g_lifecycleState>=LIFE_COMPLETED_TP)
                        ?"RESTORED "+g_tradeState
                        :"";
      g_consensusRoute=g_consensusArmed
                       ?"RESTORED ARMED COUNCIL"
                       :"WAITING";

      if(g_tradeActualEntry<=0.0 && g_tradeEntry>0.0)
         g_tradeActualEntry=g_tradeEntry;
   }

   if(PersistShadowAcrossSessions)
   {
      g_shadowActive=(LoadV9Value("SHA",0.0)>0.5);
      g_shadowDirection=(int)LoadV9Value("SHD",0.0);
      g_shadowEntry=LoadV9Value("SHE",0.0);
      g_shadowTarget=LoadV9Value("SHT",0.0);
      g_shadowStop=LoadV9Value("SHS",0.0);
      g_shadowATR=LoadV9Value("SHR",0.0);
      g_shadowEntryTime=(datetime)LoadV9Value("SHM",0.0);
      g_shadowRegime=(int)LoadV9Value("SHG",0.0);
      g_shadowMFEATR=LoadV9Value("SHF",0.0);
      g_shadowMAEATR=LoadV9Value("SHQ",0.0);
      g_shadowTrades=(int)LoadV9Value("SHN",0.0);
      g_shadowWins=(int)LoadV9Value("SHW",0.0);
      g_shadowPositiveR=LoadV9Value("SHP",0.0);
      g_shadowNegativeR=LoadV9Value("SHL",0.0);

      if(g_shadowTrades>0)
         g_shadowMeanR=
            (g_shadowPositiveR+g_shadowNegativeR)/
            (double)g_shadowTrades;
   }
}

//+------------------------------------------------------------------+
void FinalizeTradeLifecycle(int finalState,
                            double exitPrice,
                            string reason)
{
   double executionEntry=(g_tradeActualEntry>0.0)
                         ?g_tradeActualEntry
                         :g_tradeEntry;

   if(!g_tradeActive || g_tradeDirection==0 ||
      executionEntry<=0.0 || g_tradeATRAtEntry<=0.0)
   {
      return;
   }

   g_tradeExitPrice=exitPrice;
   g_tradeExitTime=TimeCurrent();
   g_tradeResultR=(
      (exitPrice-executionEntry)*g_tradeDirection-
      AssumedRoundTripCost
   )/MathMax(StopLossATR*g_tradeATRAtEntry,Point);
   g_tradeExitReason=reason;
   g_tradeActive=false;
   g_lifecycleState=finalState;
   g_tradeState=LifecycleText(finalState);

   UpdateReputationAfterOutcome(g_tradeResultR);
   UpdateProductionPerformance(g_tradeResultR);
   UpdateDriftMonitor();
   AppendEvidenceEvent(
      "LIFECYCLE_CLOSE",g_tradeState,
      g_tradeDirection,g_tradeEntry,g_tradeResultR
   );
   SaveV9PersistentState();
}

//+------------------------------------------------------------------+
void EvaluateClosedBarInvalidation()
{
   if(!EnableClosedBarInvalidation ||
      !g_tradeActive ||
      g_tradeATRAtEntry<=0.0)
   {
      return;
   }

   double currentPrice=iClose(NULL,PERIOD_H1,1);
   double executionEntry=(g_tradeActualEntry>0.0)
                         ?g_tradeActualEntry
                         :g_tradeEntry;
   double adverse=-EntryDeviationATR(
      g_tradeDirection,executionEntry,
      currentPrice,g_tradeATRAtEntry
   );

   if(g_noveltyRatio>MaximumNoveltyRatio)
   {
      FinalizeTradeLifecycle(
         LIFE_INVALIDATED,currentPrice,
         "STRUCTURAL BREAK INVALIDATION"
      );
      return;
   }

   bool oppositeQualified=(
      InvalidateOnOppositeCouncil &&
      g_liveCouncilDirection==-g_tradeDirection
   );
   bool adversePassed=(
      !OppositeCouncilRequiresAdverse ||
      adverse>=InvalidationMinimumAdverseATR
   );

   if(oppositeQualified && adversePassed)
   {
      FinalizeTradeLifecycle(
         LIFE_INVALIDATED,currentPrice,
         "OPPOSITE QUALIFIED CLOSED-BAR ROUTE"
      );
   }
}

//+------------------------------------------------------------------+
void StartShadowSignalIfEligible()
{
   if(!EnableShadowLearning || g_shadowActive ||
      g_liveATR<=0.0 || SevereDriftVeto())
   {
      return;
   }

   int direction=g_coreDirection;

   if(direction==0)
   {
      if(g_weightedBuyShare>=ShadowMinimumCouncilShare &&
         g_weightedBuyCount>=1)
      {
         direction=1;
      }
      else if(g_weightedSellShare>=ShadowMinimumCouncilShare &&
              g_weightedSellCount>=1)
      {
         direction=-1;
      }
   }

   if(direction==0)
      return;

   double entry=iOpen(NULL,PERIOD_H1,0);
   if(entry<=0.0)
      return;

   g_shadowActive=true;
   g_shadowDirection=direction;
   g_shadowEntry=entry;
   g_shadowATR=g_liveATR;
   g_shadowTarget=entry+
      direction*TakeProfitATR*g_shadowATR;
   g_shadowStop=entry-
      direction*StopLossATR*g_shadowATR;
   g_shadowEntryTime=iTime(NULL,PERIOD_H1,0);
   g_shadowRegime=g_regime;
   g_shadowMFEATR=0.0;
   g_shadowMAEATR=0.0;

   AppendShadowEvidence(
      "SHADOW_OPEN","ACTIVE",0.0
   );
   SaveV9PersistentState();
}

//+------------------------------------------------------------------+
void CompleteShadowSignal(double exitPrice,string reason)
{
   if(!g_shadowActive || g_shadowATR<=0.0)
      return;

   double resultR=(
      (exitPrice-g_shadowEntry)*g_shadowDirection-
      AssumedRoundTripCost
   )/MathMax(StopLossATR*g_shadowATR,Point);

   g_shadowTrades++;
   if(resultR>0.0)
   {
      g_shadowWins++;
      g_shadowPositiveR+=resultR;
   }
   else
   {
      g_shadowNegativeR+=resultR;
   }

   g_shadowMeanR=
      (g_shadowPositiveR+g_shadowNegativeR)/
      MathMax(1,g_shadowTrades);

   AppendShadowEvidence(
      "SHADOW_CLOSE",reason,resultR
   );

   g_shadowActive=false;
   g_shadowDirection=0;
   SaveV9PersistentState();
}

//+------------------------------------------------------------------+
void UpdateShadowSignalState()
{
   if(!g_shadowActive || g_shadowDirection==0 ||
      g_shadowATR<=0.0)
   {
      return;
   }

   double price=CurrentExitMarketPrice(g_shadowDirection);
   if(price<=0.0)
      return;

   double excursion=EntryDeviationATR(
      g_shadowDirection,g_shadowEntry,price,g_shadowATR
   );
   g_shadowMFEATR=MathMax(g_shadowMFEATR,excursion);
   g_shadowMAEATR=MathMax(g_shadowMAEATR,-excursion);

   bool stopHit=(g_shadowDirection>0)
                ?price<=g_shadowStop
                :price>=g_shadowStop;
   bool targetHit=(g_shadowDirection>0)
                  ?price>=g_shadowTarget
                  :price<=g_shadowTarget;

   if(stopHit)
   {
      CompleteShadowSignal(g_shadowStop,"STOP");
      return;
   }

   if(targetHit)
   {
      CompleteShadowSignal(g_shadowTarget,"TARGET");
      return;
   }

   int age=iBarShift(
      NULL,PERIOD_H1,g_shadowEntryTime,false
   );

   if(age>=ShadowMaximumHoldBars)
      CompleteShadowSignal(price,"TIME EXIT");
}

//+------------------------------------------------------------------+
//| Persistent Version 9 call trail                                  |
//+------------------------------------------------------------------+
string BuildTrailFileName()
{
   string symbolName=Symbol();
   StringReplace(symbolName,"\\","_");
   StringReplace(symbolName,"/","_");
   StringReplace(symbolName,":","_");

   return("XVISION_PathMiner_V12_"+symbolName+"_H1_calls.csv");
}

//+------------------------------------------------------------------+
string TrailSourceLabel(string source)
{
   if(source=="G")
      return("GLOBAL");

   if(source=="SP")
      return("SPECIALIST");

   if(source=="A")
      return("ADAPTIVE");

   return(source);
}

//+------------------------------------------------------------------+
bool CreateCallTrailMarker(datetime eventTime,
                           string source,
                           int direction,
                           double price,
                           double confidence,
                           string route,
                           bool consensus)
{
   if(!ShowCallTrail ||
      (consensus && !ShowReleasedSignalMarkers) ||
      (!consensus && !ShowInternalEngineMarkers) ||
      eventTime<=0 ||
      direction==0 ||
      price<=0.0)
   {
      return(false);
   }

   datetime displayCutoff=TrailDisplayStart;

   if(TrailHistoryDays>0)
   {
      datetime dayCutoff=TimeCurrent()-TrailHistoryDays*86400;

      if(dayCutoff>displayCutoff)
         displayCutoff=dayCutoff;
   }

   if(eventTime<displayCutoff)
      return(false);

   string markerType=consensus?"C":"E";
   string directionToken=direction>0?"B":"S";
   string name=StringConcatenate(
      TRAIL_PREFIX,markerType,"_",
      IntegerToString((int)eventTime),"_",
      source,"_",directionToken
   );

   if(ObjectFind(0,name)<0 &&
      !ObjectCreate(0,name,OBJ_ARROW,0,eventTime,price))
   {
      Print("XVISION V12: unable to create call-trail marker. Error ",
            GetLastError());
      ResetLastError();
      return(false);
   }

   int arrowCode=consensus
                 ?(direction>0
                   ?CouncilBuyArrowCode
                   :CouncilSellArrowCode)
                 :StarWingdingsCode;
   int markerWidth=consensus?CouncilArrowWidth:StarWidth;
   color markerColor=consensus
                     ?(direction>0
                       ?ConsensusBuyArrowColor
                       :ConsensusSellArrowColor)
                     :(direction>0
                       ?EngineBuyStarColor
                       :EngineSellStarColor);
   string markerLabel=consensus
                      ?"CONSENSUS"
                      :TrailSourceLabel(source)+" ENGINE";
   string tooltip=StringConcatenate(
      "XVISION PATHMINER V12 ",markerLabel,
      "\n",direction>0?"BUY":"SELL",
      " @ ",DoubleToString(price,Digits),
      "\nTIME ",TimeToString(eventTime,TIME_DATE|TIME_MINUTES),
      "\nCONFIDENCE ",DoubleToString(confidence*100.0,0),"%",
      "\nROUTE ",route
   );

   ObjectSetInteger(0,name,OBJPROP_TIME1,eventTime);
   ObjectSetDouble(0,name,OBJPROP_PRICE1,price);
   ObjectSetInteger(0,name,OBJPROP_ARROWCODE,arrowCode);
   ObjectSetInteger(0,name,OBJPROP_COLOR,markerColor);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,markerWidth);
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,name,OBJPROP_TIMEFRAMES,OBJ_ALL_PERIODS);
   ObjectSetString(0,name,OBJPROP_TOOLTIP,tooltip);

   return(true);
}

//+------------------------------------------------------------------+
void AppendCallTrailEvent(datetime eventTime,
                          string source,
                          int direction,
                          double price,
                          double confidence,
                          string route,
                          bool consensus)
{
   if(!PersistCallTrail || StringLen(g_trailFileName)<=0)
      return;

   int handle=FileOpen(
      g_trailFileName,
      FILE_READ|FILE_WRITE|FILE_CSV|FILE_COMMON,
      ';'
   );

   if(handle==INVALID_HANDLE)
   {
      Print("XVISION V12: unable to open call-trail journal. Error ",
            GetLastError());
      ResetLastError();
      return;
   }

   FileSeek(handle,0,SEEK_END);
   FileWrite(
      handle,
      IntegerToString((int)eventTime),
      source,
      IntegerToString(direction),
      DoubleToString(price,Digits),
      DoubleToString(confidence,6),
      consensus?"1":"0",
      route
   );
   FileFlush(handle);
   FileClose(handle);
}

//+------------------------------------------------------------------+
void RecordCallTrailEvent(datetime eventTime,
                          string source,
                          int direction,
                          double price,
                          double confidence,
                          string route,
                          bool consensus)
{
   if(eventTime<=0 || direction==0 || price<=0.0)
      return;

   CreateCallTrailMarker(
      eventTime,source,direction,price,
      confidence,route,consensus
   );
   AppendCallTrailEvent(
      eventTime,source,direction,price,
      confidence,route,consensus
   );
}

//+------------------------------------------------------------------+
void LoadCallTrail()
{
   if(!ShowCallTrail ||
      !PersistCallTrail ||
      StringLen(g_trailFileName)<=0 ||
      !FileIsExist(g_trailFileName,FILE_COMMON))
   {
      return;
   }

   int handle=FileOpen(
      g_trailFileName,
      FILE_READ|FILE_CSV|FILE_COMMON,
      ';'
   );

   if(handle==INVALID_HANDLE)
   {
      Print("XVISION V12: unable to read call-trail journal. Error ",
            GetLastError());
      ResetLastError();
      return;
   }

   while(!FileIsEnding(handle))
   {
      string timeText=FileReadString(handle);

      if(StringLen(timeText)<=0)
         continue;

      string source=FileReadString(handle);
      string directionText=FileReadString(handle);
      string priceText=FileReadString(handle);
      string confidenceText=FileReadString(handle);
      string consensusText=FileReadString(handle);
      string route=FileReadString(handle);

      datetime eventTime=(datetime)StringToInteger(timeText);
      int direction=(int)StringToInteger(directionText);
      double price=StringToDouble(priceText);
      double confidence=StringToDouble(confidenceText);
      bool consensus=(StringToInteger(consensusText)!=0);

      CreateCallTrailMarker(
         eventTime,source,direction,price,
         confidence,route,consensus
      );
   }

   FileClose(handle);
}

//+------------------------------------------------------------------+
int ActiveEngineCallDirection(int direction,double price)
{
   if(direction==0 || price<=0.0)
      return(0);

   return(direction);
}

//+------------------------------------------------------------------+
void InitializeEngineCallTracker()
{
   g_previousGlobalCallDirection=ActiveEngineCallDirection(
      g_globalCallDirection,g_globalCallPrice
   );
   g_previousSpecialCallDirection=ActiveEngineCallDirection(
      g_specialCallDirection,g_specialCallPrice
   );
   g_previousAdaptiveCallDirection=ActiveEngineCallDirection(
      g_adaptiveCallDirection,g_adaptiveCallPrice
   );
   g_engineCallTrackerReady=true;
}

//+------------------------------------------------------------------+
void CaptureEngineCallEvent(datetime eventTime,
                            string source,
                            int direction,
                            double price,
                            double confidence,
                            int &previousDirection)
{
   int activeDirection=ActiveEngineCallDirection(direction,price);

   if(!g_engineCallTrackerReady)
   {
      previousDirection=activeDirection;
      return;
   }

   if(activeDirection!=0 &&
      activeDirection!=previousDirection)
   {
      string route=StringConcatenate(
         RegimeText(g_regime)," | ",g_ltfState
      );

      RecordCallTrailEvent(
         eventTime,source,activeDirection,price,
         confidence,route,false
      );

      if(LogEngineCallChanges)
         AppendEvidenceEvent(
            "ENGINE_CALL",source+" "+DirectionText(activeDirection),
            activeDirection,price,0.0
         );
   }

   previousDirection=activeDirection;
}

//+------------------------------------------------------------------+
void CaptureEngineCallEvents(datetime eventTime)
{
   CaptureEngineCallEvent(
      eventTime,"G",
      g_globalCallDirection,g_globalCallPrice,
      g_globalCallConfidence,
      g_previousGlobalCallDirection
   );
   CaptureEngineCallEvent(
      eventTime,"SP",
      g_specialCallDirection,g_specialCallPrice,
      g_specialCallConfidence,
      g_previousSpecialCallDirection
   );
   CaptureEngineCallEvent(
      eventTime,"A",
      g_adaptiveCallDirection,g_adaptiveCallPrice,
      g_adaptiveCallConfidence,
      g_previousAdaptiveCallDirection
   );
}

//+------------------------------------------------------------------+
//| Stable signal marker price                                       |
//+------------------------------------------------------------------+
double SignalMarkerPrice(int direction,
                         int plotShift,
                         double atr)
{
   double offset=SignalMarkerATRPadding*atr;
   double entry=iOpen(NULL,PERIOD_H1,plotShift);

   if(entry<=0.0 || !MathIsValidNumber(entry))
   {
      return(direction>0
             ?iLow(NULL,PERIOD_H1,plotShift)-offset
             :iHigh(NULL,PERIOD_H1,plotShift)+offset);
   }

   return(direction>0 ? entry-offset : entry+offset);
}

//+------------------------------------------------------------------+
//| V9 confidence-calibrated intra-H1 entry engine                   |
//+------------------------------------------------------------------+
int CalibratedEngineCall(double buyEdge,
                         double sellEdge,
                         double minimumEdge,
                         double minimumSeparation,
                         double &confidence)
{
   confidence=0.0;

   double selected=MathMax(buyEdge,sellEdge);
   double separation=MathAbs(buyEdge-sellEdge);

   if(selected<=minimumEdge ||
      separation<minimumSeparation)
   {
      return(0);
   }

   double edgeConfidence=ClampMotionValue(
      selected/VoteEdgeConfidenceScale,0.0,1.0
   );
   double separationConfidence=ClampMotionValue(
      separation/VoteSeparationConfidenceScale,0.0,1.0
   );

   confidence=0.60*edgeConfidence+
              0.40*separationConfidence;
   confidence=ClampMotionValue(confidence,0.0,1.0);

   return(buyEdge>=sellEdge ? 1 : -1);
}

//+------------------------------------------------------------------+
bool CalculateCurrentLTFMotion(double &m5Score,
                               double &m15Score,
                               double &compositeScore,
                               double &referencePrice,
                               string &state)
{
   m5Score=0.0;
   m15Score=0.0;
   compositeScore=0.0;
   referencePrice=0.0;
   state="DATA UNAVAILABLE";

   if(!EnableLTFMotionEngine)
   {
      state="DISABLED";
      return(false);
   }

   int m5Anchor=1;
   int m15Anchor=1;
   datetime now=TimeCurrent();
   datetime m5AnchorTime=iTime(NULL,PERIOD_M5,m5Anchor);
   datetime m15AnchorTime=iTime(NULL,PERIOD_M15,m15Anchor);

   if(now<=0 || m5AnchorTime<=0 || m15AnchorTime<=0)
      return(false);

   double m5CloseAge=(double)(now-
      (m5AnchorTime+PERIOD_M5*60));
   double m15CloseAge=(double)(now-
      (m15AnchorTime+PERIOD_M15*60));

   if(m5CloseAge<0.0)
      m5CloseAge=0.0;

   if(m15CloseAge<0.0)
      m15CloseAge=0.0;

   if(m5CloseAge>
      (LTFMaximumAgeMultiplier-1.0)*PERIOD_M5*60.0 ||
      m15CloseAge>
      (LTFMaximumAgeMultiplier-1.0)*PERIOD_M15*60.0)
   {
      state="STALE LTF DATA";
      return(false);
   }

   if(!CalculateTimeframeMotion(
      PERIOD_M5,m5Anchor,LTFM5LookbackBars,m5Score))
   {
      return(false);
   }

   if(!CalculateTimeframeMotion(
      PERIOD_M15,m15Anchor,LTFM15LookbackBars,m15Score))
   {
      return(false);
   }

   double weightTotal=LTFM5Weight+LTFM15Weight;

   if(weightTotal<=0.0)
      return(false);

   compositeScore=(
      LTFM5Weight*m5Score+
      LTFM15Weight*m15Score
   )/weightTotal;

   bool conflict=(m5Score*m15Score<0.0 &&
                  MathAbs(m5Score-m15Score)>0.25);

   if(conflict)
      compositeScore*=0.65;

   compositeScore=ClampMotionValue(
      compositeScore,-1.0,1.0
   );

   double m5Close=iClose(NULL,PERIOD_M5,m5Anchor);
   double m15Close=iClose(NULL,PERIOD_M15,m15Anchor);

   if(m5Close<=0.0 || m15Close<=0.0)
      return(false);

   referencePrice=(
      LTFM5Weight*m5Close+
      LTFM15Weight*m15Close
   )/weightTotal;

   if(conflict)
      state="M5/M15 CONFLICT";
   else if(compositeScore>=0.25)
      state="BULL ACCELERATION";
   else if(compositeScore>=0.08)
      state="BULL PRESSURE";
   else if(compositeScore<=-0.25)
      state="BEAR ACCELERATION";
   else if(compositeScore<=-0.08)
      state="BEAR PRESSURE";
   else
      state="NEUTRAL MOTION";

   return(true);
}

//+------------------------------------------------------------------+
double EngineEntryCallPrice(int direction,
                            double confidence,
                            double referencePrice,
                            double atr,
                            double ltfComposite)
{
   if(direction==0 || referencePrice<=0.0 || atr<=0.0)
      return(0.0);

   double distanceATR=EngineEntryBaseOffsetATR*
      (1.0-EngineEntryConfidenceDiscount*
       ClampMotionValue(confidence,0.0,1.0));

   double motionAlignment=direction*ltfComposite;

   if(motionAlignment>=0.0)
      distanceATR*=1.0-
         EngineEntryMotionAdjustment*
         ClampMotionValue(motionAlignment,0.0,1.0);
   else
      distanceATR*=1.0+
         EngineEntryMotionAdjustment*
         ClampMotionValue(-motionAlignment,0.0,1.0);

   distanceATR=MathMax(
      EngineEntryMinimumOffsetATR,distanceATR
   );

   double callPrice=
      referencePrice+direction*distanceATR*atr;
   double livePrice=(direction>0)?Ask:Bid;

   if(livePrice>0.0)
   {
      double executionGap=MathMax(
         Point,EngineEntryMinimumOffsetATR*atr
      );

      if(direction>0)
         callPrice=MathMax(callPrice,livePrice+executionGap);
      else
         callPrice=MathMin(callPrice,livePrice-executionGap);
   }

   return(NormalizeDouble(callPrice,Digits));
}

//+------------------------------------------------------------------+
string EntryCallText(int direction,
                     double price,
                     double confidence)
{
   if(direction==0 || price<=0.0)
      return("ABSTAIN");

   return(StringConcatenate(
      direction>0?"BUY @ ":"SELL @ ",
      DoubleToString(price,Digits),
      " (",DoubleToString(confidence*100.0,0),"%)"
   ));
}

//+------------------------------------------------------------------+
void UpsertEntryCallLine(string suffix,
                         int direction,
                         double price,
                         color lineColor,
                         int lineStyle,
                         int lineWidth)
{
   string name=PREFIX+"ENTRY_"+suffix;

   if(!ShowEngineEntryLines ||
      direction==0 ||
      price<=0.0)
   {
      DeleteObject(name);
      return;
   }

   if(ObjectFind(0,name)<0)
      ObjectCreate(0,name,OBJ_HLINE,0,0,price);

   ObjectSetDouble(0,name,OBJPROP_PRICE1,price);
   ObjectSetInteger(0,name,OBJPROP_COLOR,lineColor);
   ObjectSetInteger(0,name,OBJPROP_STYLE,lineStyle);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,lineWidth);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
   ObjectSetString(
      0,name,OBJPROP_TOOLTIP,
      suffix+" "+(direction>0?"BUY @ ":"SELL @ ")+
      DoubleToString(price,Digits)
   );
}

//+------------------------------------------------------------------+
void ClearConsensusCandidate(string reason)
{
   bool wasArmed=g_consensusArmed;
   int oldDirection=g_consensusDirection;
   double oldPrice=g_consensusPrice;
   bool triggered=(StringFind(reason,"TRIGGERED",0)>=0);

   if(wasArmed && !triggered)
   {
      int finalState=LIFE_INVALIDATED;

      if(StringFind(reason,"EXPIRED",0)>=0)
         finalState=LIFE_EXPIRED;
      else if(StringFind(reason,"MISSED",0)>=0)
         finalState=LIFE_MISSED;

      if(!g_tradeActive)
      {
         g_lifecycleState=finalState;
         g_tradeState=LifecycleText(finalState);
         g_tradeDirection=oldDirection;
         g_tradeExitReason=reason;
      }

      g_consensusRoute=reason;
      AppendEvidenceEvent(
         "CANDIDATE_CLOSE",LifecycleText(finalState),
         oldDirection,oldPrice,0.0
      );
   }

   g_consensusArmed=false;
   g_consensusDirection=0;
   g_consensusPrice=0.0;
   g_consensusConfidence=0.0;
   g_consensusCreated=0;
   g_consensusRoute=reason;
   DeleteObject(PREFIX+"ENTRY_CONSENSUS");

   if(wasArmed)
      SaveV9PersistentState();
}

//+------------------------------------------------------------------+
void AddConsensusPrice(int callDirection,
                       double callPrice,
                       double callConfidence,
                       double baseWeight,
                       int consensusDirection,
                       double &weightedPrice,
                       double &weightTotal)
{
   if(callDirection!=consensusDirection ||
      callPrice<=0.0 ||
      callConfidence<=0.0 ||
      baseWeight<=0.0)
   {
      return;
   }

   double weight=baseWeight*callConfidence;
   weightedPrice+=weight*callPrice;
   weightTotal+=weight;
}

//+------------------------------------------------------------------+
void FireV8SignalAlert(int direction,
                          double entry,
                          string route)
{
   string message=StringConcatenate(
      "XVISION PathMiner Pro V12 SIGNAL ",
      direction>0?"BUY":"SELL",
      "\nRoute=",route,
      "\nTested=",DoubleToString(entry,Digits),
      " | Actual=",DoubleToString(g_tradeActualEntry,Digits),
      "\nG=",EntryCallText(
         g_globalCallDirection,
         g_globalCallPrice,
         g_globalCallConfidence),
      " | S=",EntryCallText(
         g_specialCallDirection,
         g_specialCallPrice,
         g_specialCallConfidence),
      "\nA=",EntryCallText(
         g_adaptiveCallDirection,
         g_adaptiveCallPrice,
         g_adaptiveCallConfidence),
      " | LTF=",EntryCallText(
         g_ltfCallDirection,
         g_ltfCallPrice,
         g_ltfCallConfidence),
      "\nAvailable=",DoubleToString(
         CurrentMarketPrice(direction),Digits),
      " | Lifecycle=ACTIVE",
      "\nCouncil=",g_councilExplanation,
      " | Drift=",g_driftState
   );

   Print(message);

   if(PopupAlerts)
      Alert(message);

   if(PushAlerts)
      SendNotification(message);
}

//+------------------------------------------------------------------+
bool DynamicSignalSpacingPassed(datetime signalTime)
{
   if(MinimumSignalSpacingMinutes<=0)
      return(true);

   if(!PersistCooldownAcrossSessions ||
      !GlobalVariableCheck(STATE_KEY))
   {
      return(true);
   }

   datetime lastSignal=(datetime)GlobalVariableGet(STATE_KEY);

   if(lastSignal<=0)
      return(true);

   return((signalTime-lastSignal)>=
          MinimumSignalSpacingMinutes*60);
}

//+------------------------------------------------------------------+
void UpdateV8SignalState()
{
   if(!g_tradeActive)
      return;

   double exitPrice=CurrentExitMarketPrice(g_tradeDirection);

   if(exitPrice<=0.0)
      return;

   double executionEntry=(g_tradeActualEntry>0.0)
                         ?g_tradeActualEntry
                         :g_tradeEntry;
   double excursion=EntryDeviationATR(
      g_tradeDirection,executionEntry,
      exitPrice,g_tradeATRAtEntry
   );
   g_tradeMFEATR=MathMax(g_tradeMFEATR,excursion);
   g_tradeMAEATR=MathMax(g_tradeMAEATR,-excursion);

   bool targetHit=(g_tradeDirection>0)
                  ?exitPrice>=g_tradeTarget
                  :exitPrice<=g_tradeTarget;
   bool stopHit=(g_tradeDirection>0)
                ?exitPrice<=g_tradeStop
                :exitPrice>=g_tradeStop;

   if(stopHit)
   {
      FinalizeTradeLifecycle(
         LIFE_COMPLETED_SL,g_tradeStop,"STOP HIT"
      );
      return;
   }

   if(targetHit)
   {
      FinalizeTradeLifecycle(
         LIFE_COMPLETED_TP,g_tradeTarget,"TARGET HIT"
      );
      return;
   }

   int barsSinceEntry=iBarShift(
      NULL,PERIOD_H1,g_tradeEntryTime,false
   );

   if(barsSinceEntry>=ActiveSignalExpiryH1Bars)
   {
      FinalizeTradeLifecycle(
         LIFE_EXPIRED,exitPrice,"TIME EXIT"
      );
   }
}

//+------------------------------------------------------------------+
void ArmV8Consensus(int direction,
                    double price,
                    double confidence,
                    string route)
{
   if(direction==0 || price<=0.0)
   {
      ClearConsensusCandidate("NO CONSENSUS");
      return;
   }

   double normalizedPrice=NormalizeDouble(price,Digits);

   if(g_consensusArmed &&
      g_consensusDirection==direction &&
      MathAbs(g_consensusPrice-normalizedPrice)<=
      MathMax(Point,0.05*g_liveATR))
   {
      g_consensusConfidence=ClampMotionValue(
         confidence,0.0,1.0
      );
      g_consensusRoute=route;
      return;
   }

   if(g_consensusArmed)
      ClearConsensusCandidate("REPLACED BY NEW COUNCIL");

   g_consensusArmed=true;
   g_consensusDirection=direction;
   g_consensusPrice=normalizedPrice;
   g_consensusConfidence=ClampMotionValue(
      confidence,0.0,1.0
   );
   g_consensusCreated=TimeCurrent();
   g_consensusRoute=route;
   g_signalId=(long)g_consensusCreated;
   g_lifecycleState=LIFE_ARMED;
   g_tradeState="ARMED";
   g_tradeDirection=direction;
   g_tradeExitReason="";

   UpsertEntryCallLine(
      "CONSENSUS",
      g_consensusDirection,
      g_consensusPrice,
      g_consensusDirection>0
      ?ConsensusBuyArrowColor
      :ConsensusSellArrowColor,
      STYLE_SOLID,
      2
   );

   AppendEvidenceEvent(
      "CANDIDATE_OPEN","ARMED",
      direction,g_consensusPrice,0.0
   );
   SaveV9PersistentState();
}

//+------------------------------------------------------------------+
string ImpulseSupportText(int direction)
{
   string support="";

   if(g_globalCallDirection==direction)
      support="GLOBAL";

   if(g_specialCallDirection==direction)
      support+=(StringLen(support)>0?" + ":"")+"SPECIALIST";

   if(g_adaptiveCallDirection==direction)
      support+=(StringLen(support)>0?" + ":"")+"ADAPTIVE";

   return(StringLen(support)>0?support:"H1");
}

//+------------------------------------------------------------------+
void RefreshV8EntryEngine()
{
   double referencePrice=0.0;
   string currentLTFState="DATA UNAVAILABLE";

   g_weightedBuy=0.0;
   g_weightedSell=0.0;
   g_weightedBuyShare=0.0;
   g_weightedSellShare=0.0;
   g_weightedBuyCount=0;
   g_weightedSellCount=0;
   g_councilExplanation="NO ACTIVE VOTES";
   g_liveCouncilDirection=0;
   g_liveCouncilConfidence=0.0;
   g_liveCouncilRoute="NO QUALIFIED ROUTE";

   g_ltfAvailable=CalculateCurrentLTFMotion(
      g_ltfM5Score,
      g_ltfM15Score,
      g_ltfCompositeScore,
      referencePrice,
      currentLTFState
   );
   g_ltfState=currentLTFState;

   g_globalCallDirection=CalibratedEngineCall(
      g_globalBuy,g_globalSell,
      StaticVoteMinimumEdge,
      StaticVoteMinimumSeparation,
      g_globalCallConfidence
   );
   g_specialCallDirection=CalibratedEngineCall(
      g_specialBuy,g_specialSell,
      StaticVoteMinimumEdge,
      StaticVoteMinimumSeparation,
      g_specialCallConfidence
   );

   g_adaptiveCallDirection=0;
   g_adaptiveCallConfidence=0.0;

   if(g_adaptiveN>=MinimumAdaptiveEffectiveN)
   {
      g_adaptiveCallDirection=CalibratedEngineCall(
         g_adaptiveBuy,g_adaptiveSell,
         CoreAdaptiveMinimumEdge,
         AdaptiveVoteMinimumSeparation,
         g_adaptiveCallConfidence
      );
   }

   g_ltfCallDirection=0;
   g_ltfCallConfidence=0.0;

   if(g_ltfAvailable &&
      MathAbs(g_ltfCompositeScore)>=LTFVoteMinimumScore)
   {
      g_ltfCallDirection=(g_ltfCompositeScore>0.0)?1:-1;
      g_ltfCallConfidence=ClampMotionValue(
         MathAbs(g_ltfCompositeScore),0.0,1.0
      );
   }

   if(!g_ltfAvailable || referencePrice<=0.0 || g_liveATR<=0.0)
   {
      g_globalCallPrice=0.0;
      g_specialCallPrice=0.0;
      g_adaptiveCallPrice=0.0;
      g_ltfCallPrice=0.0;
      UpsertEntryCallLine("GLOBAL",0,0.0,clrDeepSkyBlue,STYLE_DASH,1);
      UpsertEntryCallLine("SPECIAL",0,0.0,clrViolet,STYLE_DASH,1);
      UpsertEntryCallLine("ADAPTIVE",0,0.0,clrAqua,STYLE_DASH,1);
      UpsertEntryCallLine("LTF",0,0.0,clrYellow,STYLE_DASH,1);
      g_liveCouncilRoute=LTFRequireData
                         ?"WAITING FOR FRESH LTF DATA"
                         :"NO ENTRY REFERENCE";
      ClearConsensusCandidate(
         g_liveCouncilRoute
      );
      return;
   }

   g_globalCallPrice=EngineEntryCallPrice(
      g_globalCallDirection,g_globalCallConfidence,
      referencePrice,g_liveATR,g_ltfCompositeScore
   );
   g_specialCallPrice=EngineEntryCallPrice(
      g_specialCallDirection,g_specialCallConfidence,
      referencePrice,g_liveATR,g_ltfCompositeScore
   );
   g_adaptiveCallPrice=EngineEntryCallPrice(
      g_adaptiveCallDirection,g_adaptiveCallConfidence,
      referencePrice,g_liveATR,g_ltfCompositeScore
   );
   g_ltfCallPrice=EngineEntryCallPrice(
      g_ltfCallDirection,g_ltfCallConfidence,
      referencePrice,g_liveATR,g_ltfCompositeScore
   );

   UpsertEntryCallLine(
      "GLOBAL",g_globalCallDirection,g_globalCallPrice,
      clrDeepSkyBlue,STYLE_DASH,1
   );
   UpsertEntryCallLine(
      "SPECIAL",g_specialCallDirection,g_specialCallPrice,
      clrViolet,STYLE_DASH,1
   );
   UpsertEntryCallLine(
      "ADAPTIVE",g_adaptiveCallDirection,g_adaptiveCallPrice,
      clrAqua,STYLE_DASH,1
   );
   UpsertEntryCallLine(
      "LTF",g_ltfCallDirection,g_ltfCallPrice,
      clrYellow,STYLE_DASH,1
   );

   if(g_regime==REGIME_RECOVERY && !AllowRecoverySignals)
   {
      g_liveCouncilRoute="RECOVERY HYSTERESIS VETO";
      ClearConsensusCandidate(g_liveCouncilRoute);
      return;
   }

   if(g_regimeProbability<MinimumRegimeProbability)
   {
      g_liveCouncilRoute="REGIME PROBABILITY TOO LOW";
      ClearConsensusCandidate(g_liveCouncilRoute);
      return;
   }

   if(g_noveltyRatio>MaximumNoveltyRatio)
   {
      g_liveCouncilRoute="STRUCTURAL BREAK VETO";
      ClearConsensusCandidate(g_liveCouncilRoute);
      return;
   }

   if(SevereDriftVeto())
   {
      g_liveCouncilRoute="STRUCTURAL DRIFT SUSPENSION";
      ClearConsensusCandidate(g_liveCouncilRoute);
      return;
   }

   double buyWeight=0.0;
   double sellWeight=0.0;
   int buyCount=0;
   int sellCount=0;

   if(g_globalCallDirection>0)
   {
      buyWeight+=GlobalBankWeight*
         ReputationMultiplier(
            BANK_GLOBAL,g_regime,g_globalCallDirection
         )*g_globalCallConfidence;
      buyCount++;
   }
   else if(g_globalCallDirection<0)
   {
      sellWeight+=GlobalBankWeight*
         ReputationMultiplier(
            BANK_GLOBAL,g_regime,g_globalCallDirection
         )*g_globalCallConfidence;
      sellCount++;
   }

   if(g_specialCallDirection>0)
   {
      buyWeight+=SpecialistBankWeight*
         ReputationMultiplier(
            BANK_SPECIALIST,g_regime,g_specialCallDirection
         )*g_specialCallConfidence;
      buyCount++;
   }
   else if(g_specialCallDirection<0)
   {
      sellWeight+=SpecialistBankWeight*
         ReputationMultiplier(
            BANK_SPECIALIST,g_regime,g_specialCallDirection
         )*g_specialCallConfidence;
      sellCount++;
   }

   if(g_adaptiveCallDirection>0)
   {
      buyWeight+=AdaptiveMemoryWeight*
         ReputationMultiplier(
            BANK_ADAPTIVE,g_regime,g_adaptiveCallDirection
         )*g_adaptiveCallConfidence;
      buyCount++;
   }
   else if(g_adaptiveCallDirection<0)
   {
      sellWeight+=AdaptiveMemoryWeight*
         ReputationMultiplier(
            BANK_ADAPTIVE,g_regime,g_adaptiveCallDirection
         )*g_adaptiveCallConfidence;
      sellCount++;
   }

   double activeWeight=buyWeight+sellWeight;
   int bankDirection=0;
   double bankConfidence=0.0;

   g_weightedBuy=buyWeight;
   g_weightedSell=sellWeight;
   g_weightedBuyCount=buyCount;
   g_weightedSellCount=sellCount;

   if(activeWeight>0.0)
   {
      g_weightedBuyShare=buyWeight/activeWeight;
      g_weightedSellShare=sellWeight/activeWeight;
   }

   g_councilExplanation=StringConcatenate(
      "H1 B ",IntegerToString(buyCount)," ",
      DoubleToString(g_weightedBuyShare*100.0,0),"%",
      " | S ",IntegerToString(sellCount)," ",
      DoubleToString(g_weightedSellShare*100.0,0),"%"
   );

   if(activeWeight>0.0)
   {
      if(buyCount>=MinimumConsensusEngines &&
         buyWeight/activeWeight>=MinimumWeightedConsensusShare)
      {
         bankDirection=1;
         bankConfidence=buyWeight/activeWeight;
      }
      else if(sellCount>=MinimumConsensusEngines &&
              sellWeight/activeWeight>=MinimumWeightedConsensusShare)
      {
         bankDirection=-1;
         bankConfidence=sellWeight/activeWeight;
      }
   }

   int finalDirection=0;
   double finalConfidence=0.0;
   string route="NO CONSENSUS";

   if(bankDirection!=0)
   {
      double alignment=bankDirection*g_ltfCompositeScore;

      if(alignment>=LTFHardVetoAlignment)
      {
         finalDirection=bankDirection;
         finalConfidence=bankConfidence;
         route="WEIGHTED H1 COUNCIL";
      }
      else
      {
         route="H1 CONSENSUS BLOCKED BY LTF";
      }
   }

   if(finalDirection==0 &&
      EnableLTFImpulseInitiation &&
      MathAbs(g_ltfCompositeScore)>=LTFImpulseMinimumScore &&
      g_regimeProbability>=MinimumRegimeProbability &&
      g_noveltyRatio<=LTFImpulseMaximumNoveltyRatio &&
      !(g_regime==REGIME_RECOVERY && !AllowRecoverySignals))
   {
      int impulseDirection=(g_ltfCompositeScore>0.0)?1:-1;
      int supportingBanks=0;

      if(g_globalCallDirection==impulseDirection)
         supportingBanks++;
      if(g_specialCallDirection==impulseDirection)
         supportingBanks++;
      if(g_adaptiveCallDirection==impulseDirection)
         supportingBanks++;

      if(supportingBanks>=1)
      {
         finalDirection=impulseDirection;
         finalConfidence=ClampMotionValue(
            0.50*MathAbs(g_ltfCompositeScore)+
            0.50*MathMax(
               g_globalCallDirection==impulseDirection
               ?g_globalCallConfidence:0.0,
               MathMax(
                  g_specialCallDirection==impulseDirection
                  ?g_specialCallConfidence:0.0,
                  g_adaptiveCallDirection==impulseDirection
                  ?g_adaptiveCallConfidence:0.0
               )
            ),
            0.0,1.0
         );
         route="LTF IMPULSE + "+
               ImpulseSupportText(impulseDirection)+
               " SUPPORT";
      }
   }

   if(finalDirection==0)
   {
      g_liveCouncilRoute=route;
      ClearConsensusCandidate(route);
      return;
   }

   g_liveCouncilDirection=finalDirection;
   g_liveCouncilConfidence=finalConfidence;
   g_liveCouncilRoute=route;

   if(g_tradeActive)
   {
      bool opposite=(finalDirection!=g_tradeDirection);
      string activeReason=opposite
         ?"OPPOSITE LIVE ROUTE - WAITING FOR H1 CLOSE"
         :"ACTIVE TRADE ALIGNED - WAITING FOR RESOLUTION";

      ClearConsensusCandidate(activeReason);
      return;
   }

   double weightedPrice=0.0;
   double priceWeight=0.0;

   AddConsensusPrice(
      g_globalCallDirection,g_globalCallPrice,
      g_globalCallConfidence,GlobalBankWeight,
      finalDirection,weightedPrice,priceWeight
   );
   AddConsensusPrice(
      g_specialCallDirection,g_specialCallPrice,
      g_specialCallConfidence,SpecialistBankWeight,
      finalDirection,weightedPrice,priceWeight
   );
   AddConsensusPrice(
      g_adaptiveCallDirection,g_adaptiveCallPrice,
      g_adaptiveCallConfidence,AdaptiveMemoryWeight,
      finalDirection,weightedPrice,priceWeight
   );
   AddConsensusPrice(
      g_ltfCallDirection,g_ltfCallPrice,
      g_ltfCallConfidence,LTFConsensusWeight,
      finalDirection,weightedPrice,priceWeight
   );

   if(priceWeight<=0.0)
   {
      ClearConsensusCandidate("NO VALID CONSENSUS PRICE");
      return;
   }

   ArmV8Consensus(
      finalDirection,
      weightedPrice/priceWeight,
      finalConfidence,
      route
   );
}

//+------------------------------------------------------------------+
void MonitorV8ConsensusTrigger()
{
   if(!g_consensusArmed ||
      g_consensusDirection==0 ||
      g_consensusPrice<=0.0)
   {
      return;
   }

   datetime now=TimeCurrent();

   if(now<=0)
      return;

   if((now-g_consensusCreated)>
      CandidateExpiryMinutes*60)
   {
      ClearConsensusCandidate("CONSENSUS PRICE EXPIRED");
      return;
   }

   if(!DynamicSignalSpacingPassed(now))
   {
      g_consensusRoute="ARMED - MINIMUM SPACING ACTIVE";
      return;
   }

   if(g_tradeActive)
      return;

   double triggerPrice=(g_consensusDirection>0)?Ask:Bid;

   if(triggerPrice<=0.0)
      return;

   bool reached=(g_consensusDirection>0)
                ?triggerPrice>=g_consensusPrice
                :triggerPrice<=g_consensusPrice;

   if(!reached)
      return;

   string entryValidity=EntryValidityText(
      g_consensusDirection,g_consensusPrice,
      triggerPrice,g_liveATR,false
   );

   if(BlockMissedEntries && entryValidity=="MISSED")
   {
      ClearConsensusCandidate("ENTRY MISSED - NO CHASE");
      return;
   }

   string triggeredRoute=g_consensusRoute;
   PrimeBuyBuffer[0]=EMPTY_VALUE;
   PrimeSellBuffer[0]=EMPTY_VALUE;
   ImpulseBuyBuffer[0]=EMPTY_VALUE;
   ImpulseSellBuffer[0]=EMPTY_VALUE;

   RecordCallTrailEvent(
      now,"CONSENSUS",
      g_consensusDirection,triggerPrice,
      g_consensusConfidence,triggeredRoute,true
   );

   g_tradeActive=true;
   g_tradeDirection=g_consensusDirection;
   g_tradeEntry=g_consensusPrice;
   g_tradeActualEntry=triggerPrice;
   g_tradeATRAtEntry=g_liveATR;
   g_tradeTarget=g_tradeActualEntry+
      g_tradeDirection*TakeProfitATR*g_tradeATRAtEntry;
   g_tradeStop=g_tradeActualEntry-
      g_tradeDirection*StopLossATR*g_tradeATRAtEntry;
   g_tradeEntryTime=now;
   g_tradeRegime=g_regime;
   g_tradeMFEATR=0.0;
   g_tradeMAEATR=0.0;
   g_tradeResultR=0.0;
   g_tradeExitPrice=0.0;
   g_tradeExitTime=0;
   g_tradeExitReason="";
   g_tradeGlobalCall=g_globalCallDirection;
   g_tradeSpecialCall=g_specialCallDirection;
   g_tradeAdaptiveCall=g_adaptiveCallDirection;
   g_tradeLTFCall=g_ltfCallDirection;
   g_tradeReleaseBuyShare=g_weightedBuyShare;
   g_tradeReleaseSellShare=g_weightedSellShare;
   g_lifecycleState=LIFE_ACTIVE;
   g_tradeState="ACTIVE";
   g_tradeRoute=triggeredRoute;

   AppendEvidenceEvent(
      "LIFECYCLE_TRIGGER","ACTIVE",
      g_tradeDirection,g_tradeEntry,0.0
   );

   SavePersistentSignal(now);
   FireV8SignalAlert(
      g_tradeDirection,g_tradeEntry,triggeredRoute
   );
   ClearConsensusCandidate("TRIGGERED - ACTIVE SIGNAL");
   SaveV9PersistentState();
}

//+------------------------------------------------------------------+
void RenderV8EntryDiagnostics()
{
   string route=CurrentRouteText();
   int signalDirection=CurrentSignalDirection();
   color routeColor=(signalDirection!=0)
                    ?DirectionColor(signalDirection)
                    :clrSilver;

   UpsertPanelText(
      PREFIX+"CP_ROUTE_LABEL","LIFECYCLE",clrSlateGray,
      18,156,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_ROUTE",
      LifecycleText(g_lifecycleState)+" | "+route,
      routeColor,
      126,154,PanelFontSize+1,false
   );

   UpsertPanelText(
      PREFIX+"CP_CALLS_LABEL","ENTRY TRUTH",clrSlateGray,
      18,185,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_CALLS",CurrentEntryTruthText(),PanelTextColor,
      126,183,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_SIGNAL_LABEL","COUNCIL",clrSlateGray,
      18,214,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_SIGNAL",
      g_councilExplanation+" | "+CurrentSignalText(),
      routeColor,
      126,212,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_REP_LABEL","REPUTATION",clrSlateGray,
      18,243,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_REP",CurrentReputationText(),clrLightSteelBlue,
      126,241,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_DRIFT_LABEL","DRIFT",clrSlateGray,
      18,272,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_DRIFT",CurrentDriftText(),
      SevereDriftVeto()?clrOrangeRed:
      (g_driftState=="NORMAL"?clrLightGreen:clrGold),
      126,270,PanelFontSize,false
   );

   UpsertPanelText(
      PREFIX+"CP_SHADOW_LABEL","SHADOW",clrSlateGray,
      18,301,PanelFontSize,false
   );
   UpsertPanelText(
      PREFIX+"CP_SHADOW",CurrentShadowText(),
      g_shadowActive?clrAqua:clrSilver,
      126,299,PanelFontSize,false
   );
}

//+------------------------------------------------------------------+
string SignedPanelValue(double value,int decimals)
{
   string sign=(value>0.0)?"+":"";
   return(sign+DoubleToString(value,decimals));
}

//+------------------------------------------------------------------+
string CompactBankState(int direction,
                        double buyEdge,
                        double sellEdge)
{
   if(direction==0)
      return("--");

   double edge=(direction>0)?buyEdge:sellEdge;
   return(StringConcatenate(
      direction>0?"BUY ":"SELL ",
      SignedPanelValue(edge,3),"R"
   ));
}

//+------------------------------------------------------------------+
string CompactCall(string label,
                   int direction,
                   double price)
{
   if(direction==0 || price<=0.0)
      return("");

   return(StringConcatenate(
      label," ",direction>0?"BUY ":"SELL ",
      DoubleToString(price,Digits)
   ));
}

//+------------------------------------------------------------------+
string ActiveCallsText()
{
   string text="";
   string call=CompactCall(
      "G",g_globalCallDirection,g_globalCallPrice
   );

   if(StringLen(call)>0)
      text=call;

   call=CompactCall(
      "SP",g_specialCallDirection,g_specialCallPrice
   );
   if(StringLen(call)>0)
      text+=(StringLen(text)>0?" | ":"")+call;

   call=CompactCall(
      "A",g_adaptiveCallDirection,g_adaptiveCallPrice
   );
   if(StringLen(call)>0)
      text+=(StringLen(text)>0?" | ":"")+call;

   call=CompactCall(
      "LTF",g_ltfCallDirection,g_ltfCallPrice
   );
   if(StringLen(call)>0)
      text+=(StringLen(text)>0?" | ":"")+call;

   return(StringLen(text)>0?text:"NO ACTIVE CALLS");
}

//+------------------------------------------------------------------+
string CompactEngineDirection(string label,int direction)
{
   if(direction>0)
      return(label+" BUY");

   if(direction<0)
      return(label+" SELL");

   return(label+" ABSTAIN");
}

//+------------------------------------------------------------------+
string CouncilEngineCallsText()
{
   return(StringConcatenate(
      CompactEngineDirection("G",g_globalCallDirection)," | ",
      CompactEngineDirection("SP",g_specialCallDirection)," | ",
      CompactEngineDirection("A",g_adaptiveCallDirection)," | ",
      CompactEngineDirection("LTF",g_ltfCallDirection)
   ));
}

//+------------------------------------------------------------------+
int CurrentSignalDirection()
{
   if(g_tradeActive)
      return(g_tradeDirection);

   if(g_consensusArmed)
      return(g_consensusDirection);

   if(g_lifecycleState>=LIFE_COMPLETED_TP &&
      g_tradeDirection!=0)
   {
      return(g_tradeDirection);
   }

   return(0);
}

//+------------------------------------------------------------------+
string CurrentRouteText()
{
   if(g_tradeActive && StringLen(g_tradeRoute)>0)
      return(g_tradeRoute);

   if(g_consensusArmed)
      return(g_consensusRoute);

   if(g_lifecycleState==LIFE_COMPLETED_TP ||
      g_lifecycleState==LIFE_COMPLETED_SL ||
      g_lifecycleState==LIFE_EXPIRED ||
      g_lifecycleState==LIFE_INVALIDATED ||
      g_lifecycleState==LIFE_MISSED)
   {
      return(g_tradeExitReason);
   }

   return(g_consensusRoute);
}

//+------------------------------------------------------------------+
string CurrentSignalText()
{
   if(g_tradeActive)
   {
      return(StringConcatenate(
         g_tradeDirection>0?"BUY @ ":"SELL @ ",
         DoubleToString(g_tradeEntry,Digits),
         " | ACTIVE"
      ));
   }

   if(g_consensusArmed)
   {
      return(StringConcatenate(
         g_consensusDirection>0?"BUY @ ":"SELL @ ",
         DoubleToString(g_consensusPrice,Digits),
         " | ARMED"
      ));
   }

   if(g_tradeEntry>0.0 &&
      g_lifecycleState>=LIFE_COMPLETED_TP)
   {
      return(StringConcatenate(
         g_tradeDirection>0?"BUY @ ":"SELL @ ",
         DoubleToString(g_tradeEntry,Digits),
         " | ",LifecycleText(g_lifecycleState),
         " | ",SignedPanelValue(g_tradeResultR,2),"R"
      ));
   }

   return("IDLE");
}

//+------------------------------------------------------------------+
string CurrentEntryTruthText()
{
   if(g_tradeActive)
   {
      double executionEntry=(g_tradeActualEntry>0.0)
                            ?g_tradeActualEntry
                            :g_tradeEntry;
      double currentPrice=CurrentExitMarketPrice(g_tradeDirection);
      double openR=(
         (currentPrice-executionEntry)*g_tradeDirection-
         AssumedRoundTripCost
      )/MathMax(StopLossATR*g_tradeATRAtEntry,Point);
      string alignment="ROUTE NEUTRAL";

      if(g_liveCouncilDirection==g_tradeDirection)
         alignment="ROUTE ALIGNED";
      else if(g_liveCouncilDirection==-g_tradeDirection)
         alignment="OPPOSITE ROUTE";

      return(StringConcatenate(
         "ACTUAL ",DoubleToString(executionEntry,Digits),
         " | NOW ",DoubleToString(currentPrice,Digits),
         " | P/L ",SignedPanelValue(openR,2),"R",
         " | ",alignment
      ));
   }

   if(g_lifecycleState>=LIFE_COMPLETED_TP &&
      g_tradeEntry>0.0)
   {
      return(StringConcatenate(
         "TEST ",DoubleToString(g_tradeEntry,Digits),
         " | EXIT ",DoubleToString(g_tradeExitPrice,Digits),
         " | MFE ",DoubleToString(g_tradeMFEATR,2),
         " | MAE ",DoubleToString(g_tradeMAEATR,2),
         " | ",SignedPanelValue(g_tradeResultR,2),"R"
      ));
   }

   int direction=0;
   double testedEntry=0.0;
   double atr=g_liveATR;
   bool armed=false;

   if(g_tradeActive || g_lifecycleState>=LIFE_COMPLETED_TP)
   {
      direction=g_tradeDirection;
      testedEntry=g_tradeEntry;
      if(g_tradeATRAtEntry>0.0)
         atr=g_tradeATRAtEntry;
   }
   else if(g_consensusArmed)
   {
      direction=g_consensusDirection;
      testedEntry=g_consensusPrice;
      armed=true;
   }

   if(direction==0 || testedEntry<=0.0 || atr<=0.0)
      return("WAITING FOR TESTED ENTRY");

   double currentPrice=CurrentMarketPrice(direction);
   double deviation=EntryDeviationATR(
      direction,testedEntry,currentPrice,atr
   );
   string validity=EntryValidityText(
      direction,testedEntry,currentPrice,atr,armed
   );

   return(StringConcatenate(
      "TEST ",DoubleToString(testedEntry,Digits),
      " | NOW ",DoubleToString(currentPrice,Digits),
      " | DEV ",SignedPanelValue(deviation,2),
      " ATR | ",validity
   ));
}

//+------------------------------------------------------------------+
string CurrentReputationText()
{
   int direction=CurrentSignalDirection();
   if(direction==0)
   {
      if(g_weightedBuyShare>g_weightedSellShare)
         direction=1;
      else if(g_weightedSellShare>g_weightedBuyShare)
         direction=-1;
      else
         direction=1;
   }

   string text="";

   for(int bank=0;bank<BANK_COUNT;bank++)
   {
      int index=ReputationIndex(bank,g_regime,direction);
      double n=g_repN[index];
      double winRate=(n>0.0)?g_repWins[index]/n:0.0;
      double multiplier=ReputationMultiplier(
         bank,g_regime,direction
      );

      if(StringLen(text)>0)
         text+=" | ";

      text+=StringConcatenate(
         ReputationBankLabel(bank)," x",
         DoubleToString(multiplier,2),
         " N",DoubleToString(n,0),
         " W",DoubleToString(winRate*100.0,0),"%"
      );
   }

   return(text);
}

//+------------------------------------------------------------------+
string CurrentDriftText()
{
   return(StringConcatenate(
      g_driftState," ",
      DoubleToString(g_driftScore,2),
      " | NOV ",DoubleToString(g_noveltyRatio,2),
      " | PROD ",SignedPanelValue(g_productionOutcomeEWMA,2),"R",
      " | ERR ",DoubleToString(g_predictionErrorEWMA,2)
   ));
}

//+------------------------------------------------------------------+
string CurrentShadowText()
{
   double winRate=(g_shadowTrades>0)
                  ?(double)g_shadowWins/g_shadowTrades
                  :0.0;

   if(g_shadowActive)
   {
      return(StringConcatenate(
         "ACTIVE ",DirectionText(g_shadowDirection),
         " @ ",DoubleToString(g_shadowEntry,Digits),
         " | N ",IntegerToString(g_shadowTrades),
         " W ",DoubleToString(winRate*100.0,0),"%",
         " ER ",SignedPanelValue(g_shadowMeanR,2),"R"
      ));
   }

   return(StringConcatenate(
      "IDLE | N ",IntegerToString(g_shadowTrades),
      " W ",DoubleToString(winRate*100.0,0),"%",
      " ER ",SignedPanelValue(g_shadowMeanR,2),"R"
   ));
}

//+------------------------------------------------------------------+
string CompactSignalLine()
{
   if(g_tradeActive)
   {
      string routeState="LIVE ROUTE NEUTRAL";

      if(g_liveCouncilDirection==g_tradeDirection)
         routeState="LIVE ROUTE ALIGNED";
      else if(g_liveCouncilDirection==-g_tradeDirection)
         routeState="OPPOSITE "+
                    DirectionText(g_liveCouncilDirection)+
                    " - H1 CLOSE CHECK";

      return(StringConcatenate(
         "ACTIVE TRADE ",DirectionText(g_tradeDirection),
         " | ",routeState
      ));
   }

   if(g_consensusArmed)
      return(StringConcatenate(
         "ARMED ",DirectionText(g_consensusDirection),
         " | WAITING FOR TESTED ENTRY"
      ));

   return(LifecycleText(g_lifecycleState));
}

//+------------------------------------------------------------------+
string CompactCouncilRouteText()
{
   string liveRoute=(g_liveCouncilDirection==0)
                    ?"NO QUALIFIED ROUTE"
                    :StringConcatenate(
                       "LIVE ",DirectionText(g_liveCouncilDirection),
                       " ",DoubleToString(
                          g_liveCouncilConfidence*100.0,0),"%"
                    );
   string ltfCall=(g_ltfCallDirection==0)
                  ?"LTF -"
                  :"LTF "+DirectionText(g_ltfCallDirection);

   return(StringConcatenate(
      liveRoute,
      " | H1 B",DoubleToString(g_weightedBuyShare*100.0,0),
      "/S",DoubleToString(g_weightedSellShare*100.0,0),
      " | ",ltfCall
   ));
}

//+------------------------------------------------------------------+
string CompactLevelsText()
{
   if(g_tradeActive)
   {
      int ageBars=iBarShift(
         NULL,PERIOD_H1,g_tradeEntryTime,false
      );
      if(ageBars<0)
         ageBars=0;

      return(StringConcatenate(
         "TP ",DoubleToString(g_tradeTarget,Digits),
         " | SL ",DoubleToString(g_tradeStop,Digits),
         " | AGE ",IntegerToString(ageBars),"/",
         IntegerToString(ActiveSignalExpiryH1Bars)," H1"
      ));
   }

   if(g_consensusArmed)
   {
      int ageMinutes=(int)(
         (TimeCurrent()-g_consensusCreated)/60
      );
      if(ageMinutes<0)
         ageMinutes=0;

      return(StringConcatenate(
         "TEST ",DoubleToString(g_consensusPrice,Digits),
         " | ARMED ",IntegerToString(ageMinutes),"/",
         IntegerToString(CandidateExpiryMinutes)," MIN"
      ));
   }

   if(g_tradeEntry>0.0 &&
      g_lifecycleState>=LIFE_COMPLETED_TP)
   {
      return(StringConcatenate(
         "EXIT ",DoubleToString(g_tradeExitPrice,Digits),
         " | MFE ",DoubleToString(g_tradeMFEATR,2),
         " | MAE ",DoubleToString(g_tradeMAEATR,2),
         " | ",SignedPanelValue(g_tradeResultR,2),"R"
      ));
   }

   return("NO ACTIVE TP / SL");
}

//+------------------------------------------------------------------+
string CompactHealthText()
{
   return(StringConcatenate(
      g_driftState," ",
      DoubleToString(g_driftScore,2),
      " | SHADOW ",g_shadowActive?"ACTIVE":"IDLE",
      " | LOG ",EnableEvidenceLogging?"ON":"OFF"
   ));
}

//+------------------------------------------------------------------+
string CompactReputationText()
{
   int direction=CurrentSignalDirection();
   if(direction==0)
      direction=(g_weightedBuyShare>=g_weightedSellShare)?1:-1;

   return(StringConcatenate(
      "G ",DoubleToString(ReputationMultiplier(
         BANK_GLOBAL,g_regime,direction),2),
      " | SP ",DoubleToString(ReputationMultiplier(
         BANK_SPECIALIST,g_regime,direction),2),
      " | A ",DoubleToString(ReputationMultiplier(
         BANK_ADAPTIVE,g_regime,direction),2),
      " | LTF ",DoubleToString(ReputationMultiplier(
         BANK_LTF,g_regime,direction),2)
   ));
}

//+------------------------------------------------------------------+
//| Legacy H1 PRIME evaluator (not used by V9 live triggers)          |
//+------------------------------------------------------------------+
void EvaluateCurrentPrimeSignal()
{
   PrimeBuyBuffer[0]=EMPTY_VALUE;
   PrimeSellBuffer[0]=EMPTY_VALUE;

   int regime=0;
   double regimeProbability=0.0;
   double regimeDistance=0.0;
   double globalBuy=0.0;
   double globalSell=0.0;
   double specialBuy=0.0;
   double specialSell=0.0;
   double adaptiveBuy=0.0;
   double adaptiveSell=0.0;
   double adaptiveN=0.0;
   double ltfM5Score=0.0;
   double ltfM15Score=0.0;
   double ltfCompositeScore=0.0;
   double ltfAlignment=0.0;
   bool ltfAvailable=false;
   string ltfState="";
   int globalVote=0;
   int specialVote=0;
   int adaptiveVote=0;
   int coreDirection=0;
   int primeDirection=0;
   double combinedEdge=0.0;
   double atr=0.0;
   string reason="";

   if(!EvaluateCouncil(
      1,
      regime,regimeProbability,regimeDistance,
      globalBuy,globalSell,
      specialBuy,specialSell,
      adaptiveBuy,adaptiveSell,adaptiveN,
      ltfM5Score,ltfM15Score,
      ltfCompositeScore,ltfAlignment,
      ltfAvailable,ltfState,
      globalVote,specialVote,adaptiveVote,
      coreDirection,primeDirection,
      combinedEdge,atr,reason))
   {
      return;
   }

   if(primeDirection==0)
      return;

   datetime signalTime=iTime(NULL,PERIOD_H1,0);

   if(!PersistentCooldownPassed(signalTime))
      return;

   if(primeDirection>0)
      PrimeBuyBuffer[0]=SignalMarkerPrice(primeDirection,0,atr);
   else
      PrimeSellBuffer[0]=SignalMarkerPrice(primeDirection,0,atr);

   SavePersistentSignal(signalTime);

   FireAlert(
      primeDirection,
      regime,
      globalBuy,globalSell,
      specialBuy,specialSell,
      adaptiveBuy,adaptiveSell,
      adaptiveN,
      ltfM5Score,ltfM15Score,
      ltfCompositeScore,ltfAlignment,
      ltfState,
      combinedEdge,
      atr
   );
}

//+------------------------------------------------------------------+
//| Optional causal historical reconstruction                         |
//+------------------------------------------------------------------+
void ReconstructHistoricalPrimeSignals()
{
   int maximum=MathMin(
      TrailHistoryDays*24,
      iBars(NULL,PERIOD_H1)-700
   );

   if(maximum<=1)
      return;

   int lastSignalPlotShift=-1;

   for(int plotShift=maximum;
       plotShift>=0;
       plotShift--)
   {
      datetime signalTime=iTime(
         NULL,PERIOD_H1,plotShift
      );

      if(signalTime<TrailDisplayStart)
         continue;

      int descriptorShift=plotShift+1;

      int regime=0;
      double regimeProbability=0.0;
      double regimeDistance=0.0;
      double globalBuy=0.0;
      double globalSell=0.0;
      double specialBuy=0.0;
      double specialSell=0.0;
      double adaptiveBuy=0.0;
      double adaptiveSell=0.0;
      double adaptiveN=0.0;
      double ltfM5Score=0.0;
      double ltfM15Score=0.0;
      double ltfCompositeScore=0.0;
      double ltfAlignment=0.0;
      bool ltfAvailable=false;
      string ltfState="";
      int globalVote=0;
      int specialVote=0;
      int adaptiveVote=0;
      int coreDirection=0;
      int primeDirection=0;
      double combinedEdge=0.0;
      double atr=0.0;
      string reason="";

      if(!EvaluateCouncil(
         descriptorShift,
         regime,regimeProbability,regimeDistance,
         globalBuy,globalSell,
         specialBuy,specialSell,
         adaptiveBuy,adaptiveSell,adaptiveN,
         ltfM5Score,ltfM15Score,
         ltfCompositeScore,ltfAlignment,
         ltfAvailable,ltfState,
         globalVote,specialVote,adaptiveVote,
         coreDirection,primeDirection,
         combinedEdge,atr,reason))
      {
         continue;
      }

      if(primeDirection==0)
         continue;

      if(lastSignalPlotShift>=0 &&
         lastSignalPlotShift-plotShift<CooldownBars)
      {
         continue;
      }

      if(primeDirection>0)
      {
         PrimeBuyBuffer[plotShift]=
            SignalMarkerPrice(primeDirection,plotShift,atr);
      }
      else
      {
         PrimeSellBuffer[plotShift]=
            SignalMarkerPrice(primeDirection,plotShift,atr);
      }

      lastSignalPlotShift=plotShift;
   }
}

//+------------------------------------------------------------------+
//| Cache live state once per new H1 bar                             |
//+------------------------------------------------------------------+
void UpdateLiveState()
{
   g_regime=REGIME_DISTRIBUTION;
   g_regimeProbability=0.0;
   g_regimeDistance=0.0;
   g_noveltyRatio=0.0;

   g_globalBuy=0.0;
   g_globalSell=0.0;
   g_specialBuy=0.0;
   g_specialSell=0.0;
   g_adaptiveBuy=0.0;
   g_adaptiveSell=0.0;
   g_adaptiveN=0.0;
   g_combinedEdge=0.0;
   g_liveATR=0.0;
   g_liveEntry=iOpen(NULL,PERIOD_H1,0);

   g_ltfM5Score=0.0;
   g_ltfM15Score=0.0;
   g_ltfCompositeScore=0.0;
   g_ltfAlignment=0.0;
   g_ltfAvailable=false;
   g_ltfState=EnableLTFMotionEngine
              ?"NOT EVALUATED"
              :"DISABLED";

   g_globalVote=0;
   g_specialVote=0;
   g_adaptiveVote=0;
   g_coreDirection=0;
   g_primeDirection=0;
   g_primeReason="WAITING";

   EvaluateCouncil(
      1,
      g_regime,g_regimeProbability,g_regimeDistance,
      g_globalBuy,g_globalSell,
      g_specialBuy,g_specialSell,
      g_adaptiveBuy,g_adaptiveSell,g_adaptiveN,
      g_ltfM5Score,g_ltfM15Score,
      g_ltfCompositeScore,g_ltfAlignment,
      g_ltfAvailable,g_ltfState,
      g_globalVote,g_specialVote,g_adaptiveVote,
      g_coreDirection,g_primeDirection,
      g_combinedEdge,g_liveATR,g_primeReason
   );

   g_noveltyRatio=
      g_regimeDistance/
      MathMax(RegimeDistanceP95,1.0e-9);

   int contextDirection=
      (g_primeDirection!=0)
      ?g_primeDirection
      :g_coreDirection;

   g_context=ContextText(
      g_regime,
      contextDirection
   );
}

//+------------------------------------------------------------------+
string RegimeText(int regime)
{
   if(regime==REGIME_BULL_EXPANSION)
      return("BULL EXPANSION");

   if(regime==REGIME_DISTRIBUTION)
      return("DISTRIBUTION");

   if(regime==REGIME_CORRECTION)
      return("CORRECTION");

   return("RECOVERY");
}

//+------------------------------------------------------------------+
string ContextText(int regime,int direction)
{
   if(direction==0)
   {
      if(regime==REGIME_RECOVERY)
         return("RECOVERY TRANSITION - WAIT");

      return("NO ACTIONABLE ROUTE");
   }

   if(regime==REGIME_BULL_EXPANSION)
      return(direction>0
             ?"BULL CONTINUATION"
             :"BULL EXHAUSTION SELL");

   if(regime==REGIME_DISTRIBUTION)
      return(direction>0
             ?"DISTRIBUTION REBOUND"
             :"DISTRIBUTION SELL");

   if(regime==REGIME_CORRECTION)
      return(direction>0
             ?"CORRECTION REBOUND"
             :"CORRECTION CONTINUATION");

   return(direction>0
          ?"RECOVERY RE-ACCELERATION"
          :"RECOVERY FAILURE");
}

//+------------------------------------------------------------------+
string DirectionText(int direction)
{
   if(direction>0)
      return("BUY");

   if(direction<0)
      return("SELL");

   return("NO SIGNAL");
}

//+------------------------------------------------------------------+
color DirectionColor(int direction)
{
   if(direction>0)
      return(EngineBuyStarColor);

   if(direction<0)
      return(EngineSellStarColor);

   return(clrSilver);
}

//+------------------------------------------------------------------+
string StructuralBreakText()
{
   if(g_noveltyRatio>MaximumNoveltyRatio)
      return("HIGH / VETO");

   if(g_noveltyRatio>1.0)
      return("ELEVATED");

   return("NORMAL");
}

//+------------------------------------------------------------------+
void FireAlert(int direction,
               int regime,
               double globalBuy,
               double globalSell,
               double specialBuy,
               double specialSell,
               double adaptiveBuy,
               double adaptiveSell,
               double adaptiveN,
               double ltfM5Score,
               double ltfM15Score,
               double ltfCompositeScore,
               double ltfAlignment,
               string ltfState,
               double combinedEdge,
               double atr)
{
   datetime currentBar=iTime(NULL,PERIOD_H1,0);

   if(currentBar==g_lastAlertBar)
      return;

   g_lastAlertBar=currentBar;

   if(!AlertOnAttachOrRefresh &&
      currentBar==g_attachBarTime)
   {
      Print(
         "XVISION PathMiner Pro V12 LEGACY PRIME ",
         direction>0?"BUY":"SELL",
         " detected on attach/refresh bar; alert suppressed by AlertOnAttachOrRefresh=false."
      );
      return;
   }

   double entry=iOpen(NULL,PERIOD_H1,0);
   string message=StringConcatenate(
      "XVISION PathMiner Pro V12 LEGACY PRIME ",
      direction>0?"BUY":"SELL",
      " | ",ContextText(regime,direction),
      "\nRegime=",RegimeText(regime),
      " | Combined=",DoubleToString(combinedEdge,3),"R",
      "\nGlobal B/S=",DoubleToString(globalBuy,3),
      "/",DoubleToString(globalSell,3),
      "\nSpecial B/S=",DoubleToString(specialBuy,3),
      "/",DoubleToString(specialSell,3),
      "\nAdaptive B/S=",DoubleToString(adaptiveBuy,3),
      "/",DoubleToString(adaptiveSell,3),
      " | N=",DoubleToString(adaptiveN,1),
      "\nLTF M5/M15=",DoubleToString(ltfM5Score,3),
      "/",DoubleToString(ltfM15Score,3),
      " | C=",DoubleToString(ltfCompositeScore,3),
      " | A=",DoubleToString(ltfAlignment,3),
      " | ",ltfState,
      "\nEntry=",DoubleToString(entry,Digits)
   );

   Print(message);

   if(PopupAlerts)
      Alert(message);

   if(PushAlerts)
      SendNotification(message);
}

