//+------------------------------------------------------------------+
//| XVISION_PathMiner_Pro_Version12.mq4                              |
//| Corrective release: unified routing, lifecycle and execution truth.|
//| Isolated persistence, unambiguous panel and clean signal markers.  |
//+------------------------------------------------------------------+
#property strict
#property indicator_chart_window
#property indicator_buffers 4
#property indicator_color1 clrDodgerBlue
#property indicator_color2 clrRed
#property indicator_color3 clrLime
#property indicator_color4 clrRed
#property indicator_width1 3
#property indicator_width2 3
#property indicator_width3 3
#property indicator_width4 3
#property version   "12.00"
#property description "XVISION PathMiner Pro V12: unified council routing, actual-entry lifecycle, isolated persistence and verified display truth."

#define FEATURE_COUNT 75
#define REGIME_FEATURE_COUNT 13
#define REGIME_COUNT 4
#define PI_VALUE 3.14159265358979323846

#define REGIME_DISTRIBUTION 0
#define REGIME_BULL_EXPANSION 1
#define REGIME_RECOVERY 2
#define REGIME_CORRECTION 3

#define BANK_GLOBAL 0
#define BANK_SPECIALIST 1
#define BANK_ADAPTIVE 2
#define BANK_LTF 3
#define BANK_COUNT 4

#define LIFE_IDLE 0
#define LIFE_ARMED 1
#define LIFE_ACTIVE 2
#define LIFE_COMPLETED_TP 3
#define LIFE_COMPLETED_SL 4
#define LIFE_EXPIRED 5
#define LIFE_INVALIDATED 6
#define LIFE_MISSED 7

// --------------------------- Research execution profile --------------------
input int    ATRPeriod                      = 14;
input int    ExitHorizonBars                = 12;
input double TakeProfitATR                  = 1.0;
input double StopLossATR                    = 1.0;
input double AssumedRoundTripCost           = 0.30;
input int    CooldownBars                   = 12;
input bool   PersistCooldownAcrossSessions  = true;
input bool   AlertOnAttachOrRefresh         = false;

// --------------------------- Adaptive memory -------------------------------
input int    AdaptiveLookbackBars           = 360;
input double AdaptiveHalfLifeBars           = 120.0;
input double AdaptivePriorWeight            = 20.0;
input double MinimumAdaptiveEffectiveN      = 20.0;
input double CoreAdaptiveMinimumEdge        = 0.00;
input double PrimeAdaptiveMinimumEdge       = 0.03;

// --------------------------- LTF motion intelligence ----------------------
input bool   EnableLTFMotionEngine          = true;
input bool   LTFRequireData                 = true;
input int    LTFM5LookbackBars              = 12;
input int    LTFM15LookbackBars             = 8;
input double LTFMaximumAgeMultiplier        = 2.0;
input double LTFM5Weight                    = 0.40;
input double LTFM15Weight                   = 0.60;
input double LTFMinimumPrimeAlignment       = 0.05;
input double LTFHardVetoAlignment           = -0.20;
input double LTFEdgeWeight                  = 0.03;

// --------------------------- V8 conviction and entry engine ----------------
input double StaticVoteMinimumEdge          = 0.00;
input double StaticVoteMinimumSeparation    = 0.02;
input double AdaptiveVoteMinimumSeparation  = 0.02;
input double VoteEdgeConfidenceScale        = 0.15;
input double VoteSeparationConfidenceScale  = 0.10;
input double MinimumWeightedConsensusShare  = 0.60;
input int    MinimumConsensusEngines        = 2;
input double LTFVoteMinimumScore            = 0.08;
input double LTFConsensusWeight             = 0.35;
input bool   EnableLTFImpulseInitiation     = true;
input double LTFImpulseMinimumScore         = 0.30;
input double LTFImpulseMaximumNoveltyRatio  = 1.20;
input double EngineEntryBaseOffsetATR       = 0.08;
input double EngineEntryMinimumOffsetATR    = 0.01;
input double EngineEntryConfidenceDiscount = 0.60;
input double EngineEntryMotionAdjustment   = 0.50;
input int    CandidateExpiryMinutes         = 20;
input int    MinimumSignalSpacingMinutes    = 15;
input int    ActiveSignalExpiryH1Bars       = 12;
input bool   ShowEngineEntryLines           = true;

// --------------------------- V9 execution truth ----------------------------
input bool   EnableSignalLifecycle          = true;
input double EntryValidDeviationATR         = 0.15;
input double EntryExtendedDeviationATR      = 0.30;
input bool   BlockMissedEntries             = true;
input bool   EnableClosedBarInvalidation     = true;
input double InvalidationMinimumAdverseATR  = 0.20;
input bool   InvalidateOnOppositeCouncil    = true;
input bool   OppositeCouncilRequiresAdverse = false;
input bool   PersistLifecycleAcrossSessions = true;

// --------------------------- V9 model reputation ---------------------------
input bool   EnableReputationWeighting      = true;
input int    MinimumReputationSamples       = 8;
input double ReputationPriorSamples        = 12.0;
input double ReputationInfluence           = 0.60;
input double MinimumReputationMultiplier   = 0.60;
input double MaximumReputationMultiplier   = 1.40;

// --------------------------- V9 structural drift ---------------------------
input int    DriftEWMAWindow                = 20;
input double DriftWatchThreshold            = 0.45;
input double DriftSuspectedThreshold        = 0.65;
input double DriftDegradedThreshold         = 0.80;
input double DriftSuspendThreshold          = 1.00;
input bool   SuspendSignalsOnSevereDrift    = true;

// --------------------------- V9 shadow learner -----------------------------
input bool   EnableShadowLearning           = true;
input double ShadowMinimumCouncilShare      = 0.52;
input int    ShadowMaximumHoldBars          = 12;
input bool   PersistShadowAcrossSessions    = true;

// --------------------------- V9 evidence ledger ----------------------------
input bool   EnableEvidenceLogging          = true;
input bool   LogEveryClosedH1Snapshot       = true;
input bool   LogEngineCallChanges           = true;
input string EvidenceFileTag                = "PathMinerV12";

// --------------------------- Council thresholds ----------------------------
input double CoreCombinedEdge               = 0.02;
input double PrimeCombinedEdge              = 0.04;
input double MinimumStaticBankEdge          = -0.10;
input double GlobalBankWeight               = 0.35;
input double SpecialistBankWeight           = 0.35;
input double AdaptiveMemoryWeight           = 0.30;

// --------------------------- Regime protection -----------------------------
input double MinimumRegimeProbability       = 0.35;
input double RegimeProbabilityPenaltyStart  = 0.50;
input double RegimeProbabilityPenaltyWeight = 0.10;
input double RegimeDistanceP95              = 3.37247582;
input double MaximumNoveltyRatio            = 1.40;
input double NoveltyPenaltyWeight           = 0.03;
input double RegimeSoftmaxTemperature       = 6.0;
input int    RegimeSmoothingDays            = 5;
input bool   AllowRecoverySignals           = false;

// --------------------------- Display and call trail ------------------------
input bool   ShowCallTrail                  = true;
input bool   PersistCallTrail               = true;
input bool   ShowReleasedSignalMarkers      = true;
input bool   ShowInternalEngineMarkers      = false;
input int    TrailHistoryDays               = 120;
input datetime TrailDisplayStart            = D'2024.01.01 00:00';
input bool   PopupAlerts                    = false;
input bool   PushAlerts                     = false;
input int    StarWingdingsCode              = 171;
input int    StarWidth                      = 3;
input int    CouncilBuyArrowCode            = 233;
input int    CouncilSellArrowCode           = 234;
input int    CouncilArrowWidth              = 3;
input double SignalMarkerATRPadding         = 0.20;
input color  ConsensusBuyArrowColor         = clrDodgerBlue;
input color  ConsensusSellArrowColor        = clrRed;
input color  EngineBuyStarColor             = clrLime;
input color  EngineSellStarColor            = clrRed;
input bool   ShowPanel                      = true;
input int    PanelRightMargin               = 10;
input int    PanelTopMargin                 = 8;
input int    PanelWidth                     = 520;
input int    PanelHeight                    = 214;
input int    PanelFontSize                  = 9;
input color  PanelBorder                    = C'82,82,92';
input color  PanelTextColor                 = clrWhite;
input bool   ShowDetailedDiagnostics        = false;

